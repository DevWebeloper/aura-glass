[Unit]
# Blur My Shell builds one background actor per monitor and clips it to the
# panel's geometry (components/panel.js, update_size). That geometry is not
# settled at login — the source itself notes that get_transformed_position
# "sometimes yields NaN when the actor is not fully positionned yet" — and it
# is in flux again every time a monitor is plugged in or unplugged. An actor
# built during either window gets clipped in the wrong place, and part of the
# top bar shows a strip that does not line up with the wallpaper.
#
# aura-glass-panel-blur watches mutter for MonitorsChanged and rebuilds the
# actor after each one, plus once at login. That replaces a fixed `sleep 12`,
# which guessed at the login case, waited when nothing was wrong, and did
# nothing at all when the layout changed later in the session.
Description=Rebuild Blur My Shell panel blur when the monitor layout changes
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/aura-glass-panel-blur
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
