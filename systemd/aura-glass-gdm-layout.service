# System unit (installed to /etc/systemd/system by install_gdm). The login
# wallpaper for the monitors connected at boot; bin/aura-glass-gdm-layout says why.
[Unit]
Description=Pick the Aura Glass login wallpaper for the connected monitors
After=systemd-udev-trigger.service
Before=display-manager.service gdm.service gdm3.service

[Service]
Type=oneshot
User=nobody
ExecStart=/usr/local/libexec/aura-glass-gdm-layout
TimeoutStartSec=15

[Install]
WantedBy=graphical.target
