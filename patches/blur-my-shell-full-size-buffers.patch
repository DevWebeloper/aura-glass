+export function released_textures(...textures) {
+    for (const texture of textures) {
+        if (texture)
+            releasedBytes += texture.get_width() * texture.get_height() * 4;
+    }
+    if (releasedBytes < RELEASE_GC_BYTES)
+        return;
+    if (releaseGcId)
+        GLib.source_remove(releaseGcId);
+    releaseGcId = GLib.timeout_add_seconds(GLib.PRIORITY_LOW, RELEASE_GC_DELAY_S, () => {
+        releaseGcId = 0;
+        releasedBytes = 0;
+        System.gc();
+        return GLib.SOURCE_REMOVE;
+    });
