+        GLib.source_remove(releaseGcId);
+    releasedBytes = 0;
+    releaseGcId = GLib.idle_add(GLib.PRIORITY_LOW, () => {
+        releaseGcId = 0;
+        System.gc();
+        return GLib.SOURCE_REMOVE;
+    });
+}
