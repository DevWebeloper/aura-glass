From 92964be2ff904a97145cdc877699124104ed1e80 Mon Sep 17 00:00:00 2001
From: alienware <gheith.sy@gmail.com>
Date: Thu, 30 Jul 2026 16:00:08 +0300
Subject: [PATCH 2/2] prefs: drop invalid .openbar-prefs-page clamp rule

GTK CSS has no max-width property, so this rule emitted a theme parser
error on every prefs launch. The selector was also dead: the
.openbar-prefs-page class went away with the Adw.PreferencesPage removal.
---
 openbar@neuromorph/prefs.css | 4 ----
 1 file changed, 4 deletions(-)

diff --git a/openbar@neuromorph/prefs.css b/openbar@neuromorph/prefs.css
index 46e589a..0d3a871 100644
--- a/openbar@neuromorph/prefs.css
+++ b/openbar@neuromorph/prefs.css
@@ -59,10 +59,6 @@
     min-width: 200px;
 }
 
-.openbar-prefs-page clamp {
-    max-width: 9999px;
-}
-
 .openbar-sidebar StBin {
     padding: 14px;
     text-shadow: 1px 1px rgba(0, 0, 0, 0.25);
-- 
2.55.0

