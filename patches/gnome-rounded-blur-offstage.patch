diff --git a/src/rounded-blur-effect.c b/src/rounded-blur-effect.c
index 96d16e8..a57d529 100644
--- a/src/rounded-blur-effect.c
+++ b/src/rounded-blur-effect.c
@@ -471,9 +471,32 @@ update_actor_box (GbBlurEffect       *self,
         }
       else
         {
-          /* If we're drawing off stage, just assume scale = 1, this won't work
-           * with stage-view scaling though.
+          /* Off-stage paint (a screenshot): no stage view to ask. The paint
+           * target's viewport carries what one would give: the stage paints
+           * it at -(rect.x * scale), -(rect.y * scale) with a width of
+           * stage width * scale (clutter_stage_paint_to_framebuffer). Assuming
+           * scale = 1 at the stage origin misplaces the blit whenever the
+           * capture is scaled or doesn't start at 0,0 (mixed-scale monitors,
+           * a capture of one monitor).
            */
+          CoglFramebuffer *framebuffer =
+            clutter_paint_context_get_framebuffer (paint_context);
+          ClutterActor *stage = clutter_actor_get_stage (self->actor);
+          float viewport[4];
+          float stage_width;
+
+          if (framebuffer && stage)
+            {
+              cogl_framebuffer_get_viewport4fv (framebuffer, viewport);
+              stage_width = clutter_actor_get_width (stage);
+
+              if (stage_width > 0.0f && viewport[2] > 0.0f)
+                {
+                  box_scale_factor = viewport[2] / stage_width;
+                  origin_x += viewport[0] / box_scale_factor;
+                  origin_y += viewport[1] / box_scale_factor;
+                }
+            }
         }
 
       clutter_actor_box_set_origin (source_actor_box, origin_x, origin_y);
