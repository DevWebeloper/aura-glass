diff -ruN a/theme.js b/theme.js
--- a/theme.js
+++ b/theme.js
@@ -0,0 +1,180 @@
+'use strict';
+
+import GdkPixbuf from 'gi://GdkPixbuf';
+import Gio from 'gi://Gio';
+import GLib from 'gi://GLib';
+
+// Finds the picture of a cursor theme's default pointer, so the magnified
+// cursor is the one on screen whatever set org.gnome.desktop.interface
+// cursor-theme. Searched the way GNOME Shell 51 draws it. St's svg-cursor
+// (src/st/st-cursor.c, ahead of Mutter's Xcursor loader) takes
+// icons/<theme>/cursors_scalable/default/metadata.json from the user data dir,
+// then each system data dir, then its own resource, which carries Adwaita.
+// No ~/.icons, no Inherits there. Only a theme it does not find falls through
+// to Xcursor, searched like libXcursor: the user's icon dirs, the system
+// ones, then the themes named by index.theme's Inherits.
+
+const XCURSOR_MAGIC = 0x72756358; // "Xcur"
+const XCURSOR_IMAGE = 0xfffd0002;
+
+const iconRoots = () => [
+    GLib.build_filenamev([GLib.get_user_data_dir(), 'icons']),
+    GLib.build_filenamev([GLib.get_home_dir(), '.icons']),
+    ...GLib.get_system_data_dirs().map(d => GLib.build_filenamev([d, 'icons'])),
+    '/usr/share/pixmaps',
+];
+
+const readBytes = path => {
+    try {
+        const [ok, data] = GLib.file_get_contents(path);
+        return ok ? data : null;
+    } catch {
+        return null;
+    }
+};
+
+// Every directory of that name, in search order: a theme can be split, as an
+// icon theme in ~/.local/share/icons with its cursors in /usr/share/icons.
+const themeDirs = name => iconRoots()
+    .map(root => GLib.build_filenamev([root, name]))
+    .filter(dir => GLib.file_test(dir, GLib.FileTest.IS_DIR));
+
+const inherits = dir => {
+    const data = readBytes(GLib.build_filenamev([dir, 'index.theme']));
+    if (!data)
+        return [];
+    const line = new TextDecoder().decode(data).split('\n')
+        .find(l => l.trim().startsWith('Inherits'));
+    if (!line)
+        return [];
+    return line.slice(line.indexOf('=') + 1).split(/[,;]/)
+        .map(s => s.trim().replace(/^"|"$/g, '')).filter(Boolean);
+};
+
+const ST_CURSOR_RESOURCE = 'resource:///org/gnome/shell/cursor-theme/';
+
+const loadText = file => {
+    try {
+        const [ok, data] = file.load_contents(null);
+        return ok ? new TextDecoder().decode(data) : null;
+    } catch {
+        return null;
+    }
+};
+
+// The SVG's own size in pixels, as librsvg reports it to St: the root's
+// width attribute, else its viewBox width.
+const svgWidth = text => {
+    const root = text.match(/<svg\b[^>]*>/)?.[0] ?? '';
+    const width = root.match(/\swidth="\s*([\d.]+)\s*(px)?\s*"/);
+    if (width)
+        return parseFloat(width[1]);
+    const box = root.match(/\sviewBox="\s*[-\d.]+[\s,]+[-\d.]+[\s,]+([\d.]+)/);
+    return box ? parseFloat(box[1]) : null;
+};
+
+// {icon, canvas} for the SVG St would draw, or null. canvas is the SVG width
+// over its nominal size: St draws it cursor-size x that wide. Its metadata
+// names the file: AOSP's default entry is arrow.svg, Adwaita's (built in)
+// is a 32px canvas for size 24 with the tip at 8,7, unlike its Xcursor file.
+const svgCursor = name => {
+    const roots = [GLib.get_user_data_dir(), ...GLib.get_system_data_dirs()]
+        .map(d => Gio.File.new_for_path(d))
+        .concat([Gio.File.new_for_uri(ST_CURSOR_RESOURCE)]);
+    for (const root of roots) {
+        const meta = root.get_child(`icons/${name}/cursors_scalable/default/metadata.json`);
+        const desc = loadText(meta);
+        if (desc === null)
+            continue;
+        try {
+            const frame = JSON.parse(desc)[0];
+            const svg = meta.get_parent().get_child(frame.filename);
+            const width = svgWidth(loadText(svg) ?? '');
+            if (!width || !frame.nominal_size)
+                return null;
+            return {icon: Gio.FileIcon.new(svg), canvas: width / frame.nominal_size};
+        } catch {
+            return null;
+        }
+    }
+    return null;
+};
+
+// The largest nominal size of the theme's default pointer, first frame.
+const largestXcursor = dir => {
+    for (const name of ['default', 'left_ptr']) {
+        const data = readBytes(GLib.build_filenamev([dir, 'cursors', name]));
+        if (!data || data.length < 16)
+            continue;
+        const view = new DataView(data.buffer, data.byteOffset, data.byteLength);
+        if (view.getUint32(0, true) !== XCURSOR_MAGIC)
+            continue;
+        let best = null;
+        const ntoc = view.getUint32(12, true);
+        for (let i = 0; i < ntoc && 16 + i * 12 + 12 <= data.length; i++) {
+            const at = 16 + i * 12;
+            const size = view.getUint32(at + 4, true);
+            const pos = view.getUint32(at + 8, true);
+            if (view.getUint32(at, true) !== XCURSOR_IMAGE || pos + 36 > data.length)
+                continue;
+            const w = view.getUint32(pos + 16, true);
+            const h = view.getUint32(pos + 20, true);
+            if (size === 0 || pos + 36 + w * h * 4 > data.length)
+                continue;
+            if (!best || size > best.size)
+                best = {data, size, w, h, pos: pos + 36};
+        }
+        if (best)
+            return best;
+    }
+    return null;
+};
+
+// As a pixbuf. Xcursor pixels are premultiplied ARGB words, little endian;
+// a pixbuf wants straight RGBA.
+const xcursorPixbuf = ({data, w, h, pos}) => {
+    const rgba = new Uint8Array(w * h * 4);
+    for (let p = 0; p < w * h; p++) {
+        const s = pos + p * 4;
+        const a = data[s + 3];
+        let r = data[s + 2], g = data[s + 1], b = data[s];
+        if (a > 0 && a < 255) {
+            r = Math.min(255, Math.floor(r * 255 / a));
+            g = Math.min(255, Math.floor(g * 255 / a));
+            b = Math.min(255, Math.floor(b * 255 / a));
+        }
+        rgba.set([r, g, b, a], p * 4);
+    }
+    return GdkPixbuf.Pixbuf.new_from_bytes(new GLib.Bytes(rgba),
+        GdkPixbuf.Colorspace.RGB, true, 8, w, h, w * 4);
+};
+
+// {icon, canvas}: the picture, and the pointer's canvas width over its
+// nominal size (AOSP draws a 24px canvas for size 18, so 1.33). The pointer is
+// drawn cursor-size x canvas logical pixels wide whatever the monitor scale,
+// which is the size the magnified copy has to shrink back to.
+export const cursorForTheme = name => {
+    if (!name || name.includes('/'))
+        return null;
+    return svgCursor(name) ?? xcursorForTheme(name);
+};
+
+const xcursorForTheme = (name, seen = new Set()) => {
+    if (seen.has(name) || seen.size > 8)
+        return null;
+    seen.add(name);
+    const dirs = themeDirs(name);
+    for (const dir of dirs) {
+        const xcursor = largestXcursor(dir);
+        if (xcursor)
+            return {icon: xcursorPixbuf(xcursor), canvas: xcursor.w / xcursor.size};
+    }
+    for (const dir of dirs) {
+        for (const parent of inherits(dir)) {
+            const found = xcursorForTheme(parent, seen);
+            if (found)
+                return found;
+        }
+    }
+    return null;
+};
