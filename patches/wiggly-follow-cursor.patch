+'use strict';
+
+import GdkPixbuf from 'gi://GdkPixbuf';
+import Gio from 'gi://Gio';
+import GLib from 'gi://GLib';
+
+// Finds the picture of a cursor theme's default pointer, so the magnified
+// cursor is the one on screen whatever set org.gnome.desktop.interface
+// cursor-theme. Searched the way GNOME Shell 51 draws it. St's svg-cursor
+// (src/st/st-cursor.c, ahead of Mutter's Xcursor loader) takes
+// icons/<theme>/cursors_scalable/default/metadata.json from the user data dir,
+// then each system data dir, then its own resource, which carries Adwaita.
+// No ~/.icons, no Inherits there. Only a theme it does not find falls through
+// to Xcursor, searched like libXcursor: the user's icon dirs, the system
+// ones, then the themes named by index.theme's Inherits.
+
+const XCURSOR_MAGIC = 0x72756358; // "Xcur"
+const XCURSOR_IMAGE = 0xfffd0002;
+
+const iconRoots = () => [
+    GLib.build_filenamev([GLib.get_user_data_dir(), 'icons']),
+    GLib.build_filenamev([GLib.get_home_dir(), '.icons']),
+    ...GLib.get_system_data_dirs().map(d => GLib.build_filenamev([d, 'icons'])),
+    '/usr/share/pixmaps',
+];
+
+const readBytes = path => {
+    try {
+        const [ok, data] = GLib.file_get_contents(path);
+        return ok ? data : null;
+    } catch {
+        return null;
+    }
+};
+
+// Every directory of that name, in search order: a theme can be split, as an
+// icon theme in ~/.local/share/icons with its cursors in /usr/share/icons.
+const themeDirs = name => iconRoots()
+    .map(root => GLib.build_filenamev([root, name]))
+    .filter(dir => GLib.file_test(dir, GLib.FileTest.IS_DIR));
+
+const inherits = dir => {
+    const data = readBytes(GLib.build_filenamev([dir, 'index.theme']));
+    if (!data)
+        return [];
+    const line = new TextDecoder().decode(data).split('\n')
+        .find(l => l.trim().startsWith('Inherits'));
+    if (!line)
+        return [];
+    return line.slice(line.indexOf('=') + 1).split(/[,;]/)
+        .map(s => s.trim().replace(/^"|"$/g, '')).filter(Boolean);
+};
+
+const ST_CURSOR_RESOURCE = 'resource:///org/gnome/shell/cursor-theme/';
+
+const loadText = file => {
+    try {
+        const [ok, data] = file.load_contents(null);
+        return ok ? new TextDecoder().decode(data) : null;
+    } catch {
+        return null;
+    }
+};
+
+// The SVG's own size in pixels, as librsvg reports it to St: the root's
+// width and height attributes, else its viewBox.
+const svgSize = text => {
+    const root = text.match(/<svg\b[^>]*>/)?.[0] ?? '';
+    const width = root.match(/\swidth="\s*([\d.]+)\s*(px)?\s*"/);
+    const height = root.match(/\sheight="\s*([\d.]+)\s*(px)?\s*"/);
+    const box = root.match(/\sviewBox="\s*[-\d.]+[\s,]+[-\d.]+[\s,]+([\d.]+)[\s,]+([\d.]+)/);
+    const w = width ? parseFloat(width[1]) : box ? parseFloat(box[1]) : null;
+    const h = height ? parseFloat(height[1]) : box ? parseFloat(box[2]) : w;
+    return [w, h];
+};
+
+// {icon, canvas, hot, frames} for the SVG St would draw, or null. canvas is
+// the SVG width over its nominal size: St draws it cursor-size x that wide.
+// hot is the hotspot as {fraction} of the picture, which holds at any size an
+// SVG is drawn at, and frames the files of an
+// animated cursor with their delays. Its metadata names the file: AOSP's
+// default entry is arrow.svg, Adwaita's (built in) is a 32px canvas for size
+// 24 with the tip at 8,7, unlike its Xcursor file.
+const svgCursor = (name, cursor = 'default') => {
+    const roots = [GLib.get_user_data_dir(), ...GLib.get_system_data_dirs()]
+        .map(d => Gio.File.new_for_path(d))
+        .concat([Gio.File.new_for_uri(ST_CURSOR_RESOURCE)]);
+    for (const root of roots) {
+        const meta = root.get_child(`icons/${name}/cursors_scalable/${cursor}/metadata.json`);
+        const desc = loadText(meta);
+        if (desc === null)
+            continue;
+        try {
+            const entries = JSON.parse(desc);
+            const frame = entries[0];
+            const svg = meta.get_parent().get_child(frame.filename);
+            const [width, height] = svgSize(loadText(svg) ?? '');
+            if (!width || !height || !frame.nominal_size)
+                return null;
+            return {
+                icon: Gio.FileIcon.new(svg),
+                canvas: width / frame.nominal_size,
+                hot: {fraction: [frame.hotspot_x / width, frame.hotspot_y / height]},
+                frames: entries.map(e => ({
+                    file: meta.get_parent().get_child(e.filename),
+                    delay: e.delay ?? 0,
+                })),
+            };
+        } catch {
+            return null;
+        }
+    }
+    return null;
+};
+
+// The largest nominal size of a cursor in an Xcursor theme dir: the first
+// frame, and every frame of that size in order, which is how an animated
+// cursor stores its loop.
+const largestXcursor = (dir, names = ['default', 'left_ptr']) => {
+    for (const name of names) {
+        const path = GLib.build_filenamev([dir, 'cursors', name]);
+        const data = readBytes(path);
+        if (!data || data.length < 16)
+            continue;
+        const view = new DataView(data.buffer, data.byteOffset, data.byteLength);
+        if (view.getUint32(0, true) !== XCURSOR_MAGIC)
+            continue;
+        let best = null;
+        const ntoc = view.getUint32(12, true);
+        for (let i = 0; i < ntoc && 16 + i * 12 + 12 <= data.length; i++) {
+            const at = 16 + i * 12;
+            const size = view.getUint32(at + 4, true);
+            const pos = view.getUint32(at + 8, true);
+            if (view.getUint32(at, true) !== XCURSOR_IMAGE || pos + 36 > data.length)
+                continue;
+            const w = view.getUint32(pos + 16, true);
+            const h = view.getUint32(pos + 20, true);
+            if (size === 0 || pos + 36 + w * h * 4 > data.length)
+                continue;
+            const frame = {
+                w, h, pos: pos + 36,
+                xhot: view.getUint32(pos + 24, true),
+                yhot: view.getUint32(pos + 28, true),
+                delay: view.getUint32(pos + 32, true),
+            };
+            if (!best || size > best.size)
+                best = {data, path, size, ...frame, frames: [frame]};
+            else if (size === best.size)
+                best.frames.push(frame);
+        }
+        if (best)
+            return best;
+    }
+    return null;
+};
+
+// As a pixbuf. Xcursor pixels are premultiplied ARGB words, little endian;
+// a pixbuf wants straight RGBA.
+const xcursorPixbuf = ({data, w, h, pos}) => {
+    const rgba = new Uint8Array(w * h * 4);
+    for (let p = 0; p < w * h; p++) {
+        const s = pos + p * 4;
+        const a = data[s + 3];
+        let r = data[s + 2], g = data[s + 1], b = data[s];
+        if (a > 0 && a < 255) {
+            r = Math.min(255, Math.floor(r * 255 / a));
+            g = Math.min(255, Math.floor(g * 255 / a));
+            b = Math.min(255, Math.floor(b * 255 / a));
+        }
+        rgba.set([r, g, b, a], p * 4);
+    }
+    return GdkPixbuf.Pixbuf.new_from_bytes(new GLib.Bytes(rgba),
+        GdkPixbuf.Colorspace.RGB, true, 8, w, h, w * 4);
+};
+
+// {icon, canvas, hot}: the picture, the pointer's canvas width over its
+// nominal size (AOSP draws a 24px canvas for size 18, so 1.33), and its
+// hotspot as a fraction of the picture. The pointer is drawn cursor-size x
+// canvas logical pixels wide whatever the monitor scale, which is the size
+// the magnified copy has to shrink back to. The hotspot tells it when a
+// picture typed into the preferences stands in for the arrow.
+export const cursorForTheme = name => {
+    if (!name || name.includes('/'))
+        return null;
+    return svgCursor(name) ?? xcursorForTheme(name);
+};
+
+const xcursorForTheme = (name, seen = new Set(), names = undefined) => {
+    if (seen.has(name) || seen.size > 8)
+        return null;
+    seen.add(name);
+    const dirs = themeDirs(name);
+    for (const dir of dirs) {
+        const xcursor = largestXcursor(dir, names);
+        if (xcursor) {
+            return {
+                icon: names ? null : xcursorPixbuf(xcursor),
+                canvas: xcursor.w / xcursor.size,
+                hot: xcursorHot(xcursor),
+                xcursor,
+            };
+        }
+    }
+    for (const dir of dirs) {
+        for (const parent of inherits(dir)) {
+            const found = xcursorForTheme(parent, seen, names);
+            if (found)
+                return found;
+        }
+    }
+    return null;
+};
+
+// The hotspot of an Xcursor file as {fraction, bySize, animated, path, at,
+// largest}: the largest frame's as a fraction, each frame width's in pixels,
+// and where each width's first frame sits in the file, for pixels() and
+// picture() to read later. Mutter
+// draws the size nearest cursor-size x ceil(monitor scale) with the hotspot
+// that size carries, and the sizes do not agree as fractions (Moga's wait is
+// 0.250,0.292 at 48px and 0.266,0.297 at 64), so the magnified copy compares
+// in pixels at the sprite's own width when it can. Read from the table of
+// contents and the image headers alone: a theme's busy loop is megabytes.
+const xcursorHots = path => {
+    let stream = null;
+    try {
+        stream = Gio.File.new_for_path(path).read(null);
+        const read = (pos, length) => {
+            stream.seek(pos, GLib.SeekType.SET, null);
+            const bytes = stream.read_bytes(length, null).toArray();
+            return bytes.length === length
+                ? new DataView(bytes.buffer, bytes.byteOffset, length) : null;
+        };
+        const head = read(0, 16);
+        if (!head || head.getUint32(0, true) !== XCURSOR_MAGIC)
+            return null;
+        const ntoc = head.getUint32(12, true);
+        const toc = ntoc > 0 && ntoc < 4096 ? read(16, ntoc * 12) : null;
+        if (!toc)
+            return null;
+        const bySize = {};
+        const at = {};
+        const frames = {};
+        let largest = null;
+        for (let i = 0; i < ntoc; i++) {
+            if (toc.getUint32(i * 12, true) !== XCURSOR_IMAGE)
+                continue;
+            const size = toc.getUint32(i * 12 + 4, true);
+            frames[size] = (frames[size] ?? 0) + 1;
+            if (frames[size] > 1)
+                continue;
+            const image = read(toc.getUint32(i * 12 + 8, true), 36);
+            if (!image)
+                continue;
+            const [w, h] = [image.getUint32(16, true), image.getUint32(20, true)];
+            const [x, y] = [image.getUint32(24, true), image.getUint32(28, true)];
+            bySize[w] = [x, y];
+            at[w] = {h, pos: toc.getUint32(i * 12 + 8, true) + 36};
+            if (w && h && (!largest || size > largest.size))
+                largest = {size, w, h, x, y, pos: at[w].pos};
+        }
+        if (!largest)
+            return null;
+        return {
+            fraction: [largest.x / largest.w, largest.y / largest.h],
+            bySize,
+            animated: Object.values(frames).some(n => n > 1),
+            path,
+            at,
+            largest,
+        };
+    } catch {
+        return null;
+    } finally {
+        stream?.close(null);
+    }
+};
+
+const xcursorHot = xc => xcursorHots(xc.path) ?? {fraction: [xc.xhot / xc.w, xc.yhot / xc.h]};
+
+// Every shape in the theme that does not animate, as its hotspot plus where
+// its pixels are (an SVG's file and icon, an Xcursor's offsets). The
+// magnified copy names the live sprite from these. A busy loop whose hotspot
+// is none of these is told by its hotspot alone, which is
+// all there is once the pointer is magnified: hidden, it is not animated, so
+// a wait cursor met while big never ticks. Moga's wait sits 3px from the
+// nearest static shape at 64px. SVG shapes come from every St search root,
+// Xcursor ones from the first theme in the Inherits chain that has a cursors
+// dir; a shape found both ways only makes a loop less often unique.
+export const staticShapesForTheme = name => {
+    if (!name || name.includes('/'))
+        return [];
+    const found = [];
+    const roots = [GLib.get_user_data_dir(), ...GLib.get_system_data_dirs()]
+        .map(d => Gio.File.new_for_path(d))
+        .concat([Gio.File.new_for_uri(ST_CURSOR_RESOURCE)]);
+    for (const root of roots) {
+        const dir = root.get_child(`icons/${name}/cursors_scalable`);
+        let children;
+        try {
+            children = dir.enumerate_children('standard::name', Gio.FileQueryInfoFlags.NONE, null);
+        } catch {
+            continue;
+        }
+        for (const info of children) {
+            const svg = svgCursor(name, info.get_name());
+            if (svg?.frames.length === 1)
+                found.push({...svg.hot, file: svg.frames[0].file, icon: svg.icon});
+        }
+    }
+    const seen = new Set();
+    const walk = theme => {
+        if (seen.has(theme) || seen.size > 8)
+            return;
+        seen.add(theme);
+        const dirs = themeDirs(theme)
+            .map(d => GLib.build_filenamev([d, 'cursors']))
+            .filter(d => GLib.file_test(d, GLib.FileTest.IS_DIR));
+        if (!dirs.length) {
+            themeDirs(theme).forEach(d => inherits(d).forEach(walk));
+            return;
+        }
+        // Hashed aliases are symlinks, and a theme can be reached twice
+        // (~/.icons linked to ~/.local/share/icons): one file, one entry.
+        const files = new Set();
+        for (const dir of dirs) {
+            const list = Gio.File.new_for_path(dir).enumerate_children(
+                'standard::name', Gio.FileQueryInfoFlags.NONE, null);
+            for (const info of list) {
+                const path = GLib.build_filenamev([dir, info.get_name()]);
+                let id;
+                try {
+                    id = Gio.File.new_for_path(path).query_info('id::file',
+                        Gio.FileQueryInfoFlags.NONE, null).get_attribute_string('id::file');
+                } catch {
+                    continue;
+                }
+                if (files.has(id))
+                    continue;
+                files.add(id);
+                const hot = xcursorHots(path);
+                if (hot && !hot.animated)
+                    found.push(hot);
+            }
+        }
+    };
+    walk(name);
+    return found;
+};
+
+// The pixels a theme shape has at a sprite width, as straight RGBA, for the
+// magnified copy to hold against the live sprite's: [bytes, rowstride], or
+// null when the shape has no frame that wide. An Xcursor frame is read from
+// the file (premultiplied BGRA, unpremultiplied here); an SVG is drawn at
+// that width on gdk-pixbuf's worker threads. Kept on the shape, a few KB a
+// width.
+export const shapePixels = (shape, width) => {
+    shape.pixels ??= {};
+    if (width in shape.pixels)
+        return shape.pixels[width];
+    shape.pixels[width] = shape.file
+        ? svgPixels(shape.file, width)
+        : Promise.resolve(xcursorPixels(shape, width));
+    return shape.pixels[width];
+};
+
+const readAt = (path, pos, length) => {
+    let stream = null;
+    try {
+        stream = Gio.File.new_for_path(path).read(null);
+        stream.seek(pos, GLib.SeekType.SET, null);
+        const bytes = stream.read_bytes(length, null).toArray();
+        return bytes.length === length ? bytes : null;
+    } catch {
+        return null;
+    } finally {
+        stream?.close(null);
+    }
+};
+
+const xcursorPixels = (shape, width) => {
+    const frame = shape.at?.[width];
+    if (!frame)
+        return null;
+    const data = readAt(shape.path, frame.pos, width * frame.h * 4);
+    if (!data)
+        return null;
+    const rgba = new Uint8Array(data.length);
+    for (let p = 0; p < data.length; p += 4) {
+        const a = data[p + 3];
+        const k = a ? 255 / a : 0;
+        rgba[p] = Math.min(255, data[p + 2] * k);
+        rgba[p + 1] = Math.min(255, data[p + 1] * k);
+        rgba[p + 2] = Math.min(255, data[p] * k);
+        rgba[p + 3] = a;
+    }
+    return [rgba, width * 4];
+};
+
+const svgPixels = (file, width) => new Promise(resolve => {
+    let stream;
+    try {
+        stream = file.read(null);
+    } catch {
+        resolve(null);
+        return;
+    }
+    GdkPixbuf.Pixbuf.new_from_stream_at_scale_async(stream,
+        width, -1, true, null, (_source, result) => {
+            try {
+                const pixbuf = GdkPixbuf.Pixbuf.new_from_stream_finish(result);
+                resolve(pixbuf.n_channels === 4
+                    ? [pixbuf.read_pixel_bytes().toArray(), pixbuf.rowstride] : null);
+            } catch {
+                resolve(null);
+            } finally {
+                stream.close(null);
+            }
+        });
+});
+
+// The largest frame of an Xcursor shape, to be drawn magnified:
+// {width, height, bytes, rowstride, premultiplied}. SVG shapes are drawn
+// from their icon instead, sharp at any size.
+export const shapePicture = shape => {
+    const {w, h, pos} = shape.largest;
+    const data = readAt(shape.path, pos, w * h * 4);
+    return data && {width: w, height: h, bytes: new GLib.Bytes(data),
+        rowstride: w * 4, premultiplied: true};
+};
+
+// The names an app shows while it is busy. Mutter stops animating the
+// pointer while it is hidden (meta_sprite_update_cursor hands the renderer
+// NULL), so the magnified copy plays these itself, from the theme's largest
+// frames, instead of freezing on the frame the live sprite stopped at.
+const ANIMATED = ['wait', 'progress', 'watch', 'left_ptr_watch', 'half-busy'];
+
+// An SVG frame is drawn this many pixels wide: sharp at Wiggly's default
+// 96px magnified size on a 2x monitor.
+const SVG_FRAME_PIXELS = 192;
+
+// [{hot, frames}] for the theme's animated busy cursors, looked up the way
+// cursorForTheme looks up the arrow. frames() decodes the loop on first use
+// and resolves to [{width, height, bytes, rowstride, premultiplied, delay}]:
+// Xcursor pixels go as they are (premultiplied BGRA); SVG frames are drawn on
+// gdk-pixbuf's worker threads, since aosp's 88-frame loop took over half a
+// second on the shell's own. SVG themes ship each busy name as its own copy,
+// so loops are told apart by hotspot and length.
+export const animatedForTheme = name => {
+    if (!name || name.includes('/'))
+        return [];
+    const found = [];
+    const seen = new Set();
+    const add = (hot, length, frames) => {
+        const key = `${hot.fraction.map(v => v.toFixed(3))}:${length}`;
+        if (seen.has(key))
+            return;
+        seen.add(key);
+        found.push({hot, frames: once(frames)});
+    };
+    for (const cursor of ANIMATED) {
+        const svg = svgCursor(name, cursor);
+        if (svg) {
+            if (svg.frames.length > 1)
+                add(svg.hot, svg.frames.length, () => Promise.all(svg.frames.map(svgFrame)));
+            continue;
+        }
+        const xc = xcursorForTheme(name, new Set(), [cursor])?.xcursor;
+        if (xc?.frames.length > 1)
+            add(xcursorHot(xc), xc.frames.length, () => Promise.resolve(xcursorFrames(xc)));
+    }
+    return found;
+};
+
+const once = make => {
+    let made = null;
+    return () => (made ??= make());
+};
+
+const xcursorFrames = ({data, frames}) => frames.map(f => ({
+    width: f.w,
+    height: f.h,
+    bytes: new GLib.Bytes(data.subarray(f.pos, f.pos + f.w * f.h * 4)),
+    rowstride: f.w * 4,
+    premultiplied: true,
+    delay: f.delay,
+}));
+
+const svgFrame = ({file, delay}) => new Promise((resolve, reject) => {
+    const stream = file.read(null);
+    GdkPixbuf.Pixbuf.new_from_stream_at_scale_async(stream,
+        SVG_FRAME_PIXELS, -1, true, null, (_source, result) => {
+            try {
+                const pixbuf = GdkPixbuf.Pixbuf.new_from_stream_finish(result);
+                resolve({
+                    width: pixbuf.width,
+                    height: pixbuf.height,
+                    bytes: pixbuf.read_pixel_bytes(),
+                    rowstride: pixbuf.rowstride,
+                    premultiplied: false,
+                    delay,
+                });
+            } catch (e) {
+                reject(e);
+            } finally {
+                stream.close(null);
+            }
+        });
+});
