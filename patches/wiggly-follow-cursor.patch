diff -ruN a/theme.js b/theme.js
--- a/theme.js
+++ b/theme.js
@@ -0,0 +1,133 @@
+'use strict';
+
+import GdkPixbuf from 'gi://GdkPixbuf';
+import Gio from 'gi://Gio';
+import GLib from 'gi://GLib';
+
+// Finds the picture of a cursor theme's default pointer, so the magnified
+// cursor is the one on screen whatever set org.gnome.desktop.interface
+// cursor-theme. Searched like libXcursor, which is what Mutter draws the real
+// pointer with: the user's icon dirs first, then the system ones, then the
+// themes named by index.theme's Inherits.
+
+const XCURSOR_MAGIC = 0x72756358; // "Xcur"
+const XCURSOR_IMAGE = 0xfffd0002;
+
+const iconRoots = () => [
+    GLib.build_filenamev([GLib.get_user_data_dir(), 'icons']),
+    GLib.build_filenamev([GLib.get_home_dir(), '.icons']),
+    ...GLib.get_system_data_dirs().map(d => GLib.build_filenamev([d, 'icons'])),
+    '/usr/share/pixmaps',
+];
+
+const readBytes = path => {
+    try {
+        const [ok, data] = GLib.file_get_contents(path);
+        return ok ? data : null;
+    } catch {
+        return null;
+    }
+};
+
+// Every directory of that name, in search order: a theme can be split, as an
+// icon theme in ~/.local/share/icons with its cursors in /usr/share/icons.
+const themeDirs = name => iconRoots()
+    .map(root => GLib.build_filenamev([root, name]))
+    .filter(dir => GLib.file_test(dir, GLib.FileTest.IS_DIR));
+
+const inherits = dir => {
+    const data = readBytes(GLib.build_filenamev([dir, 'index.theme']));
+    if (!data)
+        return [];
+    const line = new TextDecoder().decode(data).split('\n')
+        .find(l => l.trim().startsWith('Inherits'));
+    if (!line)
+        return [];
+    return line.slice(line.indexOf('=') + 1).split(/[,;]/)
+        .map(s => s.trim().replace(/^"|"$/g, '')).filter(Boolean);
+};
+
+// A vector set in the KDE layout, used as it is. Its metadata names the file:
+// AOSP's default entry is arrow.svg, not default.svg. An SVG that only wraps
+// a PNG is skipped, because the Xcursor file underneath is the same picture.
+const vectorIcon = dir => {
+    const base = GLib.build_filenamev([dir, 'cursors_scalable', 'default']);
+    const meta = readBytes(GLib.build_filenamev([base, 'metadata.json']));
+    if (!meta)
+        return null;
+    try {
+        const svg = GLib.build_filenamev([base, JSON.parse(new TextDecoder().decode(meta))[0].filename]);
+        const body = readBytes(svg);
+        if (!body || new TextDecoder().decode(body).includes('data:image/png;base64'))
+            return null;
+        return Gio.FileIcon.new(Gio.File.new_for_path(svg));
+    } catch {
+        return null;
+    }
+};
+
+// The first frame at the largest nominal size, as a pixbuf. Xcursor pixels
+// are premultiplied ARGB words, little endian; a pixbuf wants straight RGBA.
+const xcursorIcon = dir => {
+    for (const name of ['default', 'left_ptr']) {
+        const data = readBytes(GLib.build_filenamev([dir, 'cursors', name]));
+        if (!data || data.length < 16)
+            continue;
+        const view = new DataView(data.buffer, data.byteOffset, data.byteLength);
+        if (view.getUint32(0, true) !== XCURSOR_MAGIC)
+            continue;
+        let best = null;
+        const ntoc = view.getUint32(12, true);
+        for (let i = 0; i < ntoc && 16 + i * 12 + 12 <= data.length; i++) {
+            const at = 16 + i * 12;
+            const size = view.getUint32(at + 4, true);
+            const pos = view.getUint32(at + 8, true);
+            if (view.getUint32(at, true) !== XCURSOR_IMAGE || pos + 36 > data.length)
+                continue;
+            const w = view.getUint32(pos + 16, true);
+            const h = view.getUint32(pos + 20, true);
+            if (pos + 36 + w * h * 4 > data.length)
+                continue;
+            if (!best || size > best.size)
+                best = {size, w, h, pos: pos + 36};
+        }
+        if (!best)
+            continue;
+        const {w, h, pos} = best;
+        const rgba = new Uint8Array(w * h * 4);
+        for (let p = 0; p < w * h; p++) {
+            const s = pos + p * 4;
+            const a = data[s + 3];
+            let r = data[s + 2], g = data[s + 1], b = data[s];
+            if (a > 0 && a < 255) {
+                r = Math.min(255, Math.floor(r * 255 / a));
+                g = Math.min(255, Math.floor(g * 255 / a));
+                b = Math.min(255, Math.floor(b * 255 / a));
+            }
+            rgba.set([r, g, b, a], p * 4);
+        }
+        return GdkPixbuf.Pixbuf.new_from_bytes(new GLib.Bytes(rgba),
+            GdkPixbuf.Colorspace.RGB, true, 8, w, h, w * 4);
+    }
+    return null;
+};
+
+export const cursorIconForTheme = (name, seen = new Set()) => {
+    if (!name || name.includes('/') || seen.has(name) || seen.size > 8)
+        return null;
+    seen.add(name);
+    const dirs = themeDirs(name);
+    for (const dir of dirs) {
+        const icon = vectorIcon(dir) ?? xcursorIcon(dir);
+        if (icon)
+            return icon;
+    }
+    for (const dir of dirs) {
+        for (const parent of inherits(dir)) {
+            const icon = cursorIconForTheme(parent, seen);
+            if (icon)
+                return icon;
+        }
+    }
+    return null;
+};
