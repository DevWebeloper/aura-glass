+/// True when any of a window's classes matches.
+function matches_any_class(values, patterns) {
+    return values.some(value => matches_any(value, patterns));
+}
+
+/// Every class a window can be matched under: its own wm_class, its GTK
+/// application id, and the same two for each window up its transient-for
+/// chain, so a dialog, a tool palette or a cross-process file chooser inherits
+/// the decision made for the app it came out of. Matching only get_wm_class()
+/// left those unblurred beside the window they came out of. Bounded and
+/// cycle-guarded: transient-for loops are malformed, but a client can still
+/// set one, and this runs on every window event.
+function window_classes(meta_window) {
+    const classes = [];
+    const push = value => {
+        if (value && !classes.includes(value))
+            classes.push(value);
+    };
+
+    push(meta_window.get_wm_class());
+    push(meta_window.get_gtk_application_id());
+
+    const seen = new Set([meta_window]);
+    let parent = meta_window.get_transient_for();
+    for (let depth = 0; parent && depth < 8 && !seen.has(parent); depth++) {
+        seen.add(parent);
+        push(parent.get_wm_class());
+        push(parent.get_gtk_application_id());
+        parent = parent.get_transient_for();
+    }
+    return classes;
+}
