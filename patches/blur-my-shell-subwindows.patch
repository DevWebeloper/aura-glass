+/// A window and each window up its transient-for chain, so a dialog, a tool palette or a
+/// cross-process file chooser inherits the decision made for the app it came out of, whether that
+/// decision came from its class or its title. Matching only the window itself left those unblurred
+/// beside the window they came out of. Only the window's own title change re-runs the rules, so a
+/// dialog keeps the decision its parent's title gave it until it is next checked. Bounded and
+/// cycle-guarded: transient-for loops are malformed, but a client can still set one, and this runs
+/// on every window event.
+function window_chain(meta_window) {
+    const chain = [meta_window];
+    const seen = new Set(chain);
+    let parent = meta_window.get_transient_for();
+    for (let depth = 0; parent && depth < 8 && !seen.has(parent); depth++) {
+        seen.add(parent);
+        chain.push(parent);
+        parent = parent.get_transient_for();
+    }
+    return chain;
+}
+
+function has_class(meta_window) {
+    return Boolean(meta_window.get_wm_class() || meta_window.get_gtk_application_id());
+}
+
+function matches_any(chain, rules) {
+    return rules.some(rule => chain.some(meta_window => rule(meta_window)));
 }
 
