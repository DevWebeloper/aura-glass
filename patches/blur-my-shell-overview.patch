+        } else {
+            // The blur actor is a child of the window actor, so the overview's
+            // window previews clone it along with the window they preview. Its
+            // effect samples the framebuffer wherever it is painted, and with
+            // clipped redraws on it only samples again when something damages
+            // the preview — hovering it, for instance. That leaves a preview
+            // showing a frozen picture of the desktop that jumps to a different
+            // one when the pointer arrives.
+            //
+            // `blur-on-overview: false` reads as "no window blur in the
+            // overview", so take the blur out of the previews for as long as
+            // the overview is up. Nothing here touches actor visibility:
+            // `set_focus_for_window` and the `notify::visible` handler own that
+            // and keep working either way.
+            this.connections.connect(
+                Main.overview, 'showing',
+                _ => this.meta_window_map.forEach(
+                    (meta_window, _pid) => this.set_blur_paused(meta_window, true)
+                )
+            );
+
+            this.connections.connect(
+                Main.overview, 'hidden',
+                _ => this.meta_window_map.forEach(
+                    (meta_window, _pid) => this.set_blur_paused(meta_window, false)
+                )
+            );
         }
     }
 
+    /// Stop or resume a window's blur without disturbing anything else that
+    /// owns its actor. The opacity is what a `Clutter.Clone` obeys, so it is
+    /// what takes the blur out of an overview preview; the effects are turned
+    /// off with it so the shaders do not run for something nothing can see.
+    set_blur_paused(meta_window, paused) {
+        const blur_actor = meta_window.blur_actor;
+        if (!blur_actor)
+            return;
+
+        blur_actor.opacity = paused ? 0 : 255;
+
+        const pipeline = meta_window.bg_manager?._bms_pipeline;
+        if (!pipeline)
+            return;
+
+        if (pipeline.effect)
+            pipeline.effect.set_enabled(!paused);
+        pipeline.effects?.forEach(effect => effect.set_enabled(!paused));
+    }
+
