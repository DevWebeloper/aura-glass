+    /// Run refit() after the frame that allocates the new layout: the frame
+    /// clock dispatches above idle priority, so by then the panel's position
+    /// and monitor are the new ones.
+    queue_refit() {
+        if (this._refit_id)
+            return;
+
+        this._refit_id = GLib.idle_add(GLib.PRIORITY_DEFAULT_IDLE, () => {
+            this._refit_id = 0;
+            if (this.enabled)
+                this.refit();
+            return GLib.SOURCE_REMOVE;
+        });
+    }
+
+    /// Swap the wallpaper copy of every static panel whose monitor is not the
+    /// one it was built for, or no longer has its size, and re-clip the rest.
+    /// Also blurs a panel that could not be blurred before (no monitor yet).
+    refit() {
+        [...this.actors_list].forEach(actors => {
+            const monitor = Main.layoutManager.findMonitorForActor(
+                actors.widgets.geometry_actor
+            );
+            const built = actors.built_for;
+
+            if (
+                actors.static_blur && monitor && (
+                    monitor.index !== built.index
+                    || monitor.width !== built.width
+                    || monitor.height !== built.height
+                )
+            )
+                this.swap_blur(actors);
+            else
+                this.queue_update_size(actors);
+        });
+
+        this.blur_existing_panels();
+    }
+
+    /// Build the panel a new blur, place it, then drop the old one, all before
+    /// the next frame, so no frame shows the panel without one. Unlike
+    /// destroy_blur this leaves the panel's style classes alone; taking them
+    /// off is what showed the bare panel on every reset().
+    swap_blur(actors) {
+        const panel = actors.widgets.panel;
+        const visible = actors.widgets.background.visible;
+
+        for (const [object, id] of actors.signals)
+            this.connections.disconnect(object, id);
+        this.queued_updates.delete(actors);
+        let index = this.actors_list.indexOf(actors);
+        if (index >= 0)
+            this.actors_list.splice(index, 1);
+
+        this.blur_panel(panel);
+        const fresh = this.actors_list.find(
+            other => other.widgets.panel == panel
+        );
+        if (fresh) {
+            // keep the overview/proximity hide state the old one had
+            fresh.widgets.background.visible = visible;
+            this.update_size(fresh);
+        }
+
+        this.destroy_backdrop(actors, false);
+    }
