 const OsdWindowManager = Main.osdWindowManager;
 
+// A background blur only repaints the area Clutter thinks is damaged, and the
+// OSD does not move, so the blurred pixels stay as they were the moment the
+// popup appeared. Turning clipped redraws off is what makes the blur track
+// what is behind it — the same switch Blur My Shell calls "hacks level 2".
+//
+// Mutter 18 (GNOME 50) removed meta_add_clutter_debug_flags() and its pair;
+// the switches now sit on Clutter itself, and the getter hands back the three
+// flag words rather than a list to search.
+const CLIPPED_REDRAWS = Clutter.DrawDebugFlag.DISABLE_CLIPPED_REDRAWS;
+
+function addClippedRedrawsFlag() {
+  if (Clutter.add_debug_flags)
+    Clutter.add_debug_flags(0, CLIPPED_REDRAWS, 0);
+  else
+    Meta.add_clutter_debug_flags(null, CLIPPED_REDRAWS, null);
+}
+
+function removeClippedRedrawsFlag() {
+  if (Clutter.remove_debug_flags)
+    Clutter.remove_debug_flags(0, CLIPPED_REDRAWS, 0);
+  else
+    Meta.remove_clutter_debug_flags(null, CLIPPED_REDRAWS, null);
+}
+
+function clippedRedrawsAlreadyOff() {
+  if (Clutter.get_debug_flags) {
+    const [, drawFlags] = Clutter.get_debug_flags();
+    return (drawFlags & CLIPPED_REDRAWS) != 0;
+  }
+  return Meta.get_clutter_debug_flags().includes(CLIPPED_REDRAWS);
+}
+
+const BLUR_EFFECT = 'customOSD-dynamic';
+
+// GNOME 50 replaced OsdWindowManager.show(monitorIndex, ...), where -1 meant
+// every monitor, with show(icon, label, {[index]: {level, maxLevel}}) and a
+// showAll() for the every-monitor case.
+function showOnAllMonitors(icon, label, level, maxLevel) {
+  if (OsdWindowManager.showAll)
+    OsdWindowManager.showAll(icon, label, level, maxLevel);
+  else
+    OsdWindowManager.show(-1, icon, label, level, maxLevel);
+}
+
+// Aura Glass's two designs, picked by the osd-style key (--osd-style). Each is a
+// style class and nothing else: its size, padding, radius and type are fixed
+// logical pixels in css/shell-00-flat.css, so a retune can reach them without a
+// rebuild, and nothing below may size them from the screen. Upstream's sums tie
+// the icon to monitor.height/5 and the bar's min-width to three icons, and its
+// box grows with the longest device name. Any other value of the key gets
+// upstream's layout, unchanged.
+const OSD_STYLE_CLASSES = {capsule: 'aura-osd-capsule', tab: 'aura-osd-tab'};
+
+// The bare level pill the capsule replaced was this tall (size 40 scales
+// vpadding 10 and levthickness 7 to 9 + 6 + 9). Upstream subtracts the box's own
+// height when it works out the position, which here would move the capsule by
+// about six pixels whenever a popup with a device name follows one without, so
+// the capsule stays centred where that pill was centred instead.
+const CAPSULE_ANCHOR_HEIGHT = 24;
+
+// St.BoxLayout took orientation in GNOME 48 and deprecated vertical for it.
+function setBoxVertical(box, vertical) {
+  if ('orientation' in box)
+    box.orientation = vertical ? Clutter.Orientation.VERTICAL : Clutter.Orientation.HORIZONTAL;
+  else
+    box.vertical = vertical;
+}
+
+// Where the tab hangs from, relative to its monitor. Only the primary monitor
+// has a top bar, and a fullscreen window takes it away: panelBox is tracked with
+// trackFullscreen, so its visibility says so. Measured here rather than written
+// down, because --panel-height moves it and the user can change it at any time.
+function tabTop(monitor) {
+  const panelBox = Main.layoutManager.panelBox;
+  if (monitor != Main.layoutManager.primaryMonitor || !panelBox.visible)
+    return 0;
+  return Math.max(0, panelBox.y + panelBox.height - monitor.y);
+}
