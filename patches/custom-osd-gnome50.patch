+        // Upstream drops the background entirely here. Keeping the
+        // translucent fill is what makes this read as glass rather than as a
+        // smudge, and it is the only thing carrying the popup's shape: a
+        // background blur covers the actor's bounding box and knows nothing
+        // about border-radius. Brightness is left at 1.0 below so that
+        // rectangle only ever softens what is behind it and never darkens it,
+        // which is what stops the square edge being visible at all.
+        let effect = osdW._hbox.get_effect(BLUR_EFFECT);
+        if (!effect) {
+          effect = new Shell.BlurEffect({name: BLUR_EFFECT});
+          osdW._hbox.add_effect_with_name(BLUR_EFFECT, effect);
         }
+        // Shell 18 (GNOME 50) dropped ShellBlurEffect:sigma — radius is the
+        // only knob left, and effect.set() throws on a name it cannot find,
+        // which would take the whole extension down with it.
+        effect.set({
+            // 1.0 = no darkening. The blur is a rectangle and always will
+            // be, so it must not change brightness, or its corners show
+            // outside the rounded pill drawn on top of it.
+            brightness: 1.0,
