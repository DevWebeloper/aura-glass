+/// True when a window covers its whole monitor: maximized both ways,
+/// fullscreen, or sized over the monitor's whole work area without either flag.
+/// The last is what Tiling Assistant does with maximize-with-gap on (dragging a
+/// window to the top tiles it to the work area minus the gaps, which are 0 by
+/// default), and what any tiler that resizes rather than maximizes leaves.
+/// Behind such a window the only thing left to show is the
+/// wallpaper, so a static blur of the wallpaper looks the same as the dynamic
+/// blur of the stage there. It costs far less: the static blur is computed once
+/// and cached, where the dynamic one copies and re-blurs the window's whole
+/// area from the framebuffer every time anything under or in it repaints, and a
+/// maximized window is the largest area there is. A smaller window keeps the
+/// dynamic blur, since other windows show through it.
+function coversMonitor(meta_window) {
+    if (meta_window.fullscreen
+        || (meta_window.maximized_horizontally && meta_window.maximized_vertically))
+        return true;
+    const area = meta_window.get_work_area_current_monitor();
+    const frame = meta_window.get_frame_rect();
+    return frame.x <= area.x && frame.y <= area.y
+        && frame.x + frame.width >= area.x + area.width
+        && frame.y + frame.height >= area.y + area.height;
+}
