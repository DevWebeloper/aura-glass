+/// Whether a window covers its monitor: maximized both ways, fullscreen, or sized over the monitor's
+/// whole work area without either flag. The last is what Tiling Assistant's drag-to-top leaves with
+/// maximize-with-gap on, since it resizes the window instead of maximizing it. The same test as
+/// coversMonitor in Aura Glass Helper, which shades the top bar behind such a window. A window on
+/// no monitor has no work area, nor a monitor's background to make a static blur from.
+export function covers_monitor(meta_window) {
+    if (meta_window.get_monitor() < 0)
+        return false;
+    if (meta_window.fullscreen
+        || (meta_window.maximized_horizontally && meta_window.maximized_vertically))
+        return true;
+    const area = meta_window.get_work_area_current_monitor();
+    const frame = meta_window.get_frame_rect();
+    return frame.x <= area.x && frame.y <= area.y
+        && frame.x + frame.width >= area.x + area.width
+        && frame.y + frame.height >= area.y + area.height;
+}
