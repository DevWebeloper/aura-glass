#!/usr/bin/env bash
# Show a candidate tint, transparency, radius, blur strength, popup blur or
# window-blur scope on the real desktop, without writing anything install.sh
# would read back on the next run.
#
#     aura-glass-preview begin
#     aura-glass-preview set [--app-tint HEX] [--shell-tint HEX]
#                            [--transparency LEVEL] [--radius-preset NAME]
#                            [--radius-custom W,M,Q,N,D,P,O]
#                            [--blur-strength PCT] [--popup-blur 0|1]
#                            [--popup-brightness PCT]
#                            [--notification-opacity PCT]
#                            [--window-blur 0|1] [--scope gtk|all]
#                            [--app-blur-allow LIST] [--app-blur-block LIST]
#     aura-glass-preview apps --allow LIST --block LIST
#                             [--window-blur 0|1] [--scope gtk|all]
#     aura-glass-preview revert
#     aura-glass-preview status
#
# apps is set's per-app-blur-only sibling: four dconf writes through
# apply_app_blur and nothing else — no install_css, no aura-glass-apply. The
# settings window's Per-app blur page calls it on every switch flipped, and a
# switch is not a reason to rebuild the whole CSS pipeline; set stays the path
# for a tint, transparency or radius candidate, where that pipeline is the
# point.
#
# begin snapshots the installed CSS sheets, the blur-my-shell dconf subtree and
# the $CONF_DIR memos that the functions below would otherwise overwrite. set
# then calls the *same* apply_* functions lib/steps-css.sh and
# lib/steps-dconf.sh give install.sh --settings-only, against a CSS baseline
# reset from css/ on every call — the same reset install_css itself does before
# a real install_transparency_css or apply_shell_tint_color, which is what
# keeps a relative rewrite (transparency, shell tint) from compounding across
# repeated calls while a slider is being dragged. Reusing the real functions
# rather than a second copy of their math is deliberate: this project's whole
# architecture is built around there being exactly one place that resolves a
# flag into a file, and a preview with its own copy of that resolution would
# drift from it within a release.
#
# The one thing set is not allowed to do is leave a $CONF_DIR memo different
# from what it was before begin. That is the whole safety property this script
# exists to keep: Settings() in the GUI, and install.sh on the next real run,
# must see exactly what was last actually applied, never a preview that happened
# to be showing.
#
# It is kept by not writing the memos at all. set exports PREVIEW_MODE=1, which
# remembering() in lib/common.sh reads, and every apply_* function below skips
# its memo write. It used to be kept the other way round — write, then restore
# the snapshot begin took — and that restore was only safe while nothing else
# was writing the same files. Apply is something else writing the same files:
# pressed while a set is still in flight, install.sh --settings-only wrote the
# new memo and this script's restore put the old one back a moment later, so the
# window re-read the old value and every preset click appeared to snap back to
# whatever was already installed. There is now nothing to restore and nothing to
# race.
#
# revert restores the CSS sheets and the blur-my-shell dconf subtree
# byte-for-byte from the snapshot and re-splices, so closing a preview without
# keeping it leaves the desktop exactly as it was before begin ran.
set -euo pipefail

operation="$(dirname "${BASH_SOURCE[0]}")/aura-glass-operation"
[ -x "$operation" ] || operation="$HOME/.local/bin/aura-glass-operation"
if ! "$operation" held >/dev/null 2>&1; then
    exec "$operation" run -- bash "$0" "$@"
fi

CONF_DIR="$HOME/.config/aura-glass"
MARKER="$CONF_DIR/preview-active"
BACKUP="$CONF_DIR/preview-backup"

if [ ! -r "$CONF_DIR/repo-path" ]; then
    printf 'aura-glass-preview: %s/repo-path is missing — nothing installed to preview against.\n' "$CONF_DIR" >&2
    exit 1
fi
REPO_ROOT="$(cat "$CONF_DIR/repo-path")"
if [ ! -d "$REPO_ROOT" ]; then
    printf 'aura-glass-preview: the checkout at %s is gone.\n' "$REPO_ROOT" >&2
    exit 1
fi

# shellcheck source=../lib/common.sh
. "$REPO_ROOT/lib/common.sh"
# shellcheck source=../lib/steps.sh
. "$REPO_ROOT/lib/steps.sh"
# shellcheck source=../lib/steps-modes.sh
. "$REPO_ROOT/lib/steps-modes.sh"
# shellcheck source=../lib/steps-css.sh
. "$REPO_ROOT/lib/steps-css.sh"
# shellcheck source=../lib/steps-dconf.sh
. "$REPO_ROOT/lib/steps-dconf.sh"
# shellcheck source=../tokens/tokens.sh
. "$REPO_ROOT/tokens/tokens.sh"

BMS=/org/gnome/shell/extensions/blur-my-shell

# The memos every function this script calls would write if PREVIEW_MODE did not
# stop it. set no longer touches any of them, but begin still snapshots them and
# revert still restores them: that is what repairs a $CONF_DIR left mid-preview
# by an older build of this script.
PREVIEW_MEMOS="app-tint-color shell-tint-color app-transparency radius-preset radius-custom blur-strength popup-brightness notification-opacity popup-blur notification-blur window-blur app-blur-scope app-blur-allow app-blur-block"

usage() {
    printf 'usage: aura-glass-preview begin|set [options]|apps [options]|app-blur --wm-class CLASS --enabled 0|1|commit --session ID -- INSTALLER [ARG...]|revert [--session ID]|status [--json]\n' >&2
    exit 2
}

require_begun() {
    if [ ! -d "$BACKUP" ]; then
        printf 'aura-glass-preview: no preview is active — run "begin" first.\n' >&2
        exit 1
    fi
}

# The literal `pipelines=` value dconf/core.ini ships, so a blur-strength
# preview can always scale from the tuned 100% baseline rather than from
# whatever a previous tick left in dconf — apply_blur_strength's own comment
# spells out why compounding is the failure mode this avoids.
shipped_pipelines() {
    awk -F'=' '
        /^\[extensions\/blur-my-shell\]/ { in_section = 1; next }
        /^\[/ { in_section = 0 }
        in_section && $1 == "pipelines" { sub(/^pipelines=/, ""); print; exit }
    ' "$REPO_ROOT/dconf/core.ini"
}

cmd_begin() {
    if [ -d "$BACKUP" ]; then
        # Already running — a second slider move mid-drag, not a new preview.
        # Nothing to snapshot again; the first begin's backup is still the
        # truth of what to revert to.
        cat "$BACKUP/session" 2>/dev/null || true
        return 0
    fi
    local staging session
    staging="$(mktemp -d "$CONF_DIR/.preview-backup.XXXXXX")"
    session="$(basename "$staging" | sed 's/^\.preview-backup\.//')"
    mkdir -p "$staging/memos"
    local sheet
    for sheet in "$CONF_DIR"/shell-*.css "$CONF_DIR"/gtk4-*.css "$CONF_DIR/gtk3-tweaks.css"; do
        [ -f "$sheet" ] && cp -a "$sheet" "$staging/"
    done
    local name
    for name in $PREVIEW_MEMOS; do
        [ -f "$CONF_DIR/$name" ] && cp -a "$CONF_DIR/$name" "$staging/memos/"
    done
    dconf dump "$BMS/" > "$staging/blur-my-shell.dconf"
    printf '%s\n' 1 > "$staging/schema-version"
    printf '%s\n' "$session" > "$staging/session"
    printf '%s\n' "${REPO_ROOT}" > "$staging/source-checkout"
    mv "$staging" "$BACKUP"
    touch "$MARKER"
    printf '%s\n' "$session"
}

# Put every memo back to exactly what begin found — present or absent, since a
# memo created that did not exist before is as much a change as one that was
# edited. Only revert calls this now; set writes nothing to put back.
restore_memos() {
    local name
    for name in $PREVIEW_MEMOS; do
        if [ -f "$BACKUP/memos/$name" ]; then
            cp -a "$BACKUP/memos/$name" "$CONF_DIR/$name"
        else
            rm -f "$CONF_DIR/$name"
        fi
    done
}

cmd_set() {
    require_begun

    local session="" app_tint="" shell_tint="" transparency="" radius_preset="" \
        radius_custom="" blur_strength="" popup_brightness="" notification_opacity="" \
        popup_blur="" notification_blur="" window_blur="" scope="" \
        app_blur_allow="" app_blur_allow_given=0 \
        app_blur_block="" app_blur_block_given=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --session) session="$2"; shift 2 ;;
            --app-tint) app_tint="$2"; shift 2 ;;
            --shell-tint) shell_tint="$2"; shift 2 ;;
            --transparency) transparency="$2"; shift 2 ;;
            --radius-preset) radius_preset="$2"; shift 2 ;;
            --radius-custom) radius_custom="$2"; shift 2 ;;
            --blur-strength) blur_strength="$2"; shift 2 ;;
            --popup-brightness) popup_brightness="$2"; shift 2 ;;
            --notification-opacity) notification_opacity="$2"; shift 2 ;;
            --popup-blur) popup_blur="$2"; shift 2 ;;
            --notification-blur) notification_blur="$2"; shift 2 ;;
            --window-blur) window_blur="$2"; shift 2 ;;
            --scope) scope="$2"; shift 2 ;;
            --app-blur-allow) app_blur_allow="$2"; app_blur_allow_given=1; shift 2 ;;
            --app-blur-block) app_blur_block="$2"; app_blur_block_given=1; shift 2 ;;
            *) usage ;;
        esac
    done
    check_session "$session"

    # Read by remembering() in lib/common.sh: the apply_* functions below do
    # every rewrite they normally do and skip every $CONF_DIR memo. See the
    # header for why not writing beats writing and restoring.
    export PREVIEW_MODE=1

    # Frosted or transparent only — solid mode removes the whole theme rather
    # than tuning it, and is applied, never previewed.
    export WANT_BLUR=1
    export WANT_POPUP_BLUR="${popup_blur:-1}"
    export WANT_NOTIFICATION_BLUR="${notification_blur:-1}"
    export APP_TRANSPARENCY="${transparency:-0}"
    [ -n "$app_tint" ] && export APP_TINT_COLOR="$app_tint"
    [ -n "$shell_tint" ] && export SHELL_TINT_COLOR="$shell_tint"
    # Read by apply_notification_opacity, inside the install_css below — the
    # sheet it rewrites is one install_css has just laid down, so it cannot be
    # set after that call the way the dconf knobs below are.
    [ -n "$notification_opacity" ] && export NOTIFICATION_OPACITY="$notification_opacity"

    if [ -n "$radius_custom" ]; then
        IFS=',' read -r TOKEN_RADIUS_WINDOW TOKEN_RADIUS_MENU \
            TOKEN_RADIUS_QUICK_SETTINGS TOKEN_RADIUS_NOTIFICATION \
            TOKEN_RADIUS_DIALOG TOKEN_RADIUS_POPUP TOKEN_RADIUS_OSD \
            TOKEN_RADIUS_BUTTON \
            <<< "$radius_custom"
    else
        radius_preset_values "${radius_preset:-default}" \
            || die "aura-glass-preview: unknown radius preset '$radius_preset'"
    fi
    export RADIUS_PRESET="${radius_preset:-custom}"

    # install_css resets every sheet from css/ before it touches any of them —
    # that reset is what makes calling this on every tick safe rather than
    # cumulative. It ends by running aura-glass-apply itself, which splices the
    # result into the theme and forces the shell to reload it.
    install_css >/dev/null

    export WINDOW_BLUR_EXPLICIT=1
    export WANT_WINDOW_BLUR="${window_blur:-1}"
    export APP_BLUR_SCOPE_EXPLICIT=1
    export APP_BLUR_SCOPE="${scope:-gtk}"
    if [ "$app_blur_allow_given" = 1 ]; then
        export APP_BLUR_ALLOW_EXPLICIT=1
        export APP_BLUR_ALLOW="$app_blur_allow"
    fi
    if [ "$app_blur_block_given" = 1 ]; then
        export APP_BLUR_BLOCK_EXPLICIT=1
        export APP_BLUR_BLOCK="$app_blur_block"
    fi
    apply_app_blur >/dev/null

    export POPUP_BLUR_EXPLICIT=1
    export WANT_POPUP_BLUR="${popup_blur:-1}"
    apply_popup_blur >/dev/null

    export NOTIFICATION_BLUR_EXPLICIT=1
    export WANT_NOTIFICATION_BLUR="${notification_blur:-1}"
    apply_notification_blur >/dev/null

    if [ -n "$blur_strength" ] && [ "$blur_strength" != 100 ]; then
        local shipped
        shipped="$(shipped_pipelines)"
        if [ -n "$shipped" ]; then
            dconf write "$BMS/pipelines" "$shipped"
        fi
        export BLUR_STRENGTH="$blur_strength"
        apply_blur_strength >/dev/null
    fi

    # Beside the strength, and after it for the reason apply_popup_brightness's
    # own comment gives: the block above resets the whole `pipelines` blob from
    # the shipped literal, and the brightness this writes lives inside it.
    if [ -n "$popup_brightness" ]; then
        export POPUP_BRIGHTNESS="$popup_brightness"
        apply_popup_brightness >/dev/null
    fi

    # Last, and after the blur-strength block above rather than before it. That
    # block resets the whole `pipelines` blob from the shipped literal, and
    # apply_radius_dconf's corner effect lives inside that same blob — run the
    # other way round, a preview at any strength but 100% put the windows blur
    # corner back to the shipped 30 behind a window painted at the candidate.
    # load_dconf in lib/steps-dconf.sh keeps the same order for the same reason.
    apply_radius_dconf >/dev/null
}

cmd_apps() {
    require_begun

    local session="" allow="" block="" window_blur="1" scope="gtk"
    while [ $# -gt 0 ]; do
        case "$1" in
            --session) session="$2"; shift 2 ;;
            --allow) allow="$2"; shift 2 ;;
            --block) block="$2"; shift 2 ;;
            --window-blur) window_blur="$2"; shift 2 ;;
            --scope) scope="$2"; shift 2 ;;
            *) usage ;;
        esac
    done
    check_session "$session"

    export PREVIEW_MODE=1
    export WANT_BLUR=1
    export WINDOW_BLUR_EXPLICIT=1
    export WANT_WINDOW_BLUR="$window_blur"
    export APP_BLUR_SCOPE_EXPLICIT=1
    export APP_BLUR_SCOPE="$scope"
    export APP_BLUR_ALLOW_EXPLICIT=1
    export APP_BLUR_ALLOW="$allow"
    export APP_BLUR_BLOCK_EXPLICIT=1
    export APP_BLUR_BLOCK="$block"
    apply_app_blur >/dev/null
}

cmd_app_blur() {
    # This is intentionally not a preview mutation.  The Shell menu changes a
    # saved preference, so it runs under aura-glass-operation and reuses the
    # canonical list/memo/dconf writer rather than replacing lists calculated
    # before it obtained the shared descriptor.
    [ ! -d "$BACKUP" ] || die "aura-glass-preview: a preview is active; finish it before changing an app blur rule"
    local wm_class="" enabled="" allow_lines block_lines
    while [ $# -gt 0 ]; do
        case "$1" in
            --wm-class) wm_class="${2:-}"; shift 2 ;;
            --enabled) enabled="${2:-}"; shift 2 ;;
            *) usage ;;
        esac
    done
    [ -n "$wm_class" ] || usage
    case "$enabled" in 0|1) ;; *) usage ;; esac

    allow_lines="$(app_blur_lines "" "" "$CONF_DIR/app-blur-allow" "${APP_BLUR_ALLOW_DEFAULT[@]}")"
    block_lines="$(app_blur_lines "" "" "$CONF_DIR/app-blur-block" "${APP_BLUR_BLOCK_DEFAULT[@]}")"
    # The extension's wildcardToRegex escapes every regex metacharacter except
    # * and ?.  Keep that exact membership rule here so a menu action removes
    # the same covering wildcard it used to remove synchronously.
    eval "$(APP_BLUR_ALLOW_INPUT="$allow_lines" APP_BLUR_BLOCK_INPUT="$block_lines" \
        python3 - "$wm_class" "$enabled" <<'PY'
import os
import re
import shlex
import sys

wm_class, enabled = sys.argv[1], sys.argv[2]

def lines(name):
    return [line.strip() for line in os.environ[name].splitlines()
            if line.strip()]

def covers(pattern):
    escaped = re.escape(pattern).replace(r"\*", ".*").replace(r"\?", ".")
    return re.fullmatch(escaped, wm_class, flags=re.I) is not None

def edit(entries, wanted, label):
    covered = [item for item in entries if covers(item)]
    widened = [item for item in covered if item.lower() != wm_class.lower()]
    if wanted:
        if not covered:
            entries.append(wm_class)
    else:
        entries[:] = [item for item in entries if item not in covered]
    for item in widened:
        print("aura-glass-app-blur-wildcard: %s: %s" % (label, item),
              file=sys.stderr)

allow, block = lines("APP_BLUR_ALLOW_INPUT"), lines("APP_BLUR_BLOCK_INPUT")
is_on = enabled == "1"
edit(allow, is_on, "always-blur")
edit(block, not is_on, "never-blur")
print("APP_BLUR_ALLOW=" + shlex.quote(",".join(allow)))
print("APP_BLUR_BLOCK=" + shlex.quote(",".join(block)))
PY
    )"
    export APP_BLUR_ALLOW APP_BLUR_BLOCK
    export APP_BLUR_ALLOW_EXPLICIT=1 APP_BLUR_BLOCK_EXPLICIT=1
    export WINDOW_BLUR_EXPLICIT=1 WANT_WINDOW_BLUR=1 WANT_BLUR=1
    apply_app_blur
}

check_session() {
    local wanted="${1:-}" actual
    [ -n "$wanted" ] || return 0
    actual="$(cat "$BACKUP/session" 2>/dev/null || true)"
    [ "$wanted" = "$actual" ] || die "aura-glass-preview: session '$wanted' does not own this preview"
}

cmd_revert() {
    local session=""
    if [ "${1:-}" = --session ]; then
        session="${2:-}"
        shift 2
    fi
    [ -d "$BACKUP" ] || exit 0
    check_session "$session"

    # Byte-for-byte: put back exactly the sheets begin found, and remove any
    # set created that was not there before (shell-popup-blur.css toggled on
    # mid-preview, say).
    local sheet base
    for sheet in "$CONF_DIR"/shell-*.css "$CONF_DIR"/gtk4-*.css "$CONF_DIR/gtk3-tweaks.css"; do
        base="$(basename "$sheet")"
        [ -f "$BACKUP/$base" ] || rm -f "$sheet"
    done
    for sheet in "$BACKUP"/*.css; do
        [ -f "$sheet" ] && cp -a "$sheet" "$CONF_DIR/$(basename "$sheet")"
    done

    dconf reset -f "$BMS/"
    dconf load "$BMS/" < "$BACKUP/blur-my-shell.dconf"

    restore_memos

    "$HOME/.local/bin/aura-glass-apply" >/dev/null

    rm -rf "$BACKUP" "$MARKER"
}

cmd_status() {
    local json=0
    [ "${1:-}" != --json ] || json=1
    if [ -d "$BACKUP" ]; then
        if [ "$json" = 1 ]; then
            printf '{"schema_version":1,"state":"previewing","session_id":"%s","revision":0,"recovery_available":true,"conflicts":[]}\n' \
                "$(cat "$BACKUP/session" 2>/dev/null || true)"
            return
        fi
        printf 'active\n'
    else
        if [ "$json" = 1 ]; then
            printf '%s\n' '{"schema_version":1,"state":"idle","session_id":null,"revision":0,"recovery_available":false,"conflicts":[]}'
            return
        fi
        printf 'idle\n'
    fi
}

cmd_commit() {
    [ "${1:-}" = --session ] || usage
    local session="$2"
    shift 2
    [ "${1:-}" = -- ] || usage
    shift
    require_begun
    check_session "$session"
    if "$@"; then
        rm -rf "$BACKUP" "$MARKER"
        return 0
    fi
    # Preserve the recovery journal if restoring cannot finish; the caller can
    # still request an explicit revert rather than losing the pre-preview state.
    cmd_revert --session "$session" || true
    return 1
}

case "${1:-}" in
    begin)  shift; cmd_begin "$@" ;;
    set)    shift; cmd_set "$@" ;;
    apps)   shift; cmd_apps "$@" ;;
    app-blur) shift; cmd_app_blur "$@" ;;
    commit) shift; cmd_commit "$@" ;;
    revert) shift; cmd_revert "$@" ;;
    status) shift; cmd_status "$@" ;;
    *) usage ;;
esac
