#!/usr/bin/env bash
# Put the aura-glass checkout on exactly one release, or one branch's newest
# commit, and run the full installer from it.
#
#   aura-glass-update vX.Y.Z      a release tag
#   aura-glass-update main        main's newest commit (or any other branch)
#   aura-glass-update --no-install <target>   switch the checkout only
#
# This replaces `git pull --ff-only`, which is what the settings window used to
# run. A pull asks the checkout to already be in a state it can move on from: on
# a branch, tracking a remote branch, with no local edits and no history of its
# own. Real checkouts are often none of those — a release tag checked out by
# hand is a detached HEAD, a hand-edited stylesheet is a dirty tree, a tag that
# was re-cut on the remote clobbers on fetch, and a main that someone committed
# on has diverged. Each of those used to grey the Install button out or stop the
# pull with git's own message, and none of them is something a theme user should
# have to untangle. So nothing here asks what state the checkout is in; it is
# moved to the named ref, and whatever was there is kept somewhere it can be got
# back from rather than refused or thrown away:
#
#   local edits        → git stash, with a message naming when and from where
#   a diverged branch  → a branch aura-glass-backup/<branch>-<timestamp>
#
# A tag is checked out detached, which is what bin/aura-glass-update-check
# already reads as "on the released line". A branch is reset to its remote copy
# and set to track it, which is what it reads as "following commits".
#
# Everything is in main() and called on the last line, because bash reads a
# script as it runs it, and the checkout below may replace this very file when
# it is run from the repository rather than from ~/.local/bin.
set -euo pipefail

# The update window. The settings window writes the changelog it read into a
# run directory, names it in AURA_GLASS_PROGRESS_DIR and names
# gui/aura_glass_install_progress.py in AURA_GLASS_UPDATE_WINDOW, which main()
# opens in update mode once the sudo password is in. This script then sends
# its output to the window's log and its two steps, fetching and switching, to
# its events, in the format lib/progress.sh documents; the install.sh it runs
# inherits the variable and adds its own steps and the finish. Repeated here
# rather than sourced, because the copy in ~/.local/bin has no lib/ beside it.
PROGRESS_DIR=""
PROGRESS_STEP=""

pjson() {
    local s="$2"
    s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; s="${s//$'\n'/\\n}"; s="${s//$'\t'/\\t}"
    printf -v "$1" '"%s"' "$s"
}

pevent() {
    [ -n "$PROGRESS_DIR" ] || return 0
    local line field
    pjson field "$1"; line="{\"t\":$field"; shift
    while [ "$#" -ge 2 ]; do
        pjson field "$1"; line+=",$field:"
        pjson field "$2"; line+="$field"
        shift 2
    done
    printf '%s}\n' "$line" >> "$PROGRESS_DIR/events" 2>/dev/null || true
}

poffset() { stat -c %s "$PROGRESS_DIR/log" 2>/dev/null || echo 0; }

pstart() {
    [ -n "$PROGRESS_DIR" ] || return 0
    [ -z "$PROGRESS_STEP" ] || pevent end id "$PROGRESS_STEP" status ok offset "$(poffset)"
    PROGRESS_STEP="$1"
    [ -z "$1" ] || pevent start id "$1" offset "$(poffset)"
}

# fail MESSAGE — say why on stderr and in the window, and stop.
fail() {
    echo "aura-glass-update: $*" >&2
    pevent note id "$PROGRESS_STEP" level error text "$*"
    exit 1
}

# On exit: close the running step, and finish the window unless the install.sh
# below already did (it does, before its logout question).
pexit() {
    local rc="$1"
    [ -n "$PROGRESS_DIR" ] || return 0
    if [ -n "$PROGRESS_STEP" ]; then
        pevent end id "$PROGRESS_STEP" status "$([ "$rc" = 0 ] && echo ok || echo fail)" offset "$(poffset)"
    fi
    grep -q '"t":"finish"' "$PROGRESS_DIR/events" 2>/dev/null && return 0
    pevent finish status "$([ "$rc" = 0 ] && echo ok || echo fail)" rc "$rc"
}

main() {
    local install=1
    if [ "${1:-}" = "--no-install" ]; then
        install=0
        shift
    fi
    local target="${1:-}"
    if [ -z "$target" ]; then
        echo "usage: aura-glass-update [--no-install] <vX.Y.Z | branch>" >&2
        exit 2
    fi

    local conf="${AURA_GLASS_CONF:-$HOME/.config/aura-glass}"
    local repo
    repo="$(cat "$conf/repo-path" 2>/dev/null || true)"

    # The sudo password, asked once here in the terminal before the update
    # window opens over it. The install.sh below finds it in sudo's cache and
    # holds it to the end (its own sudo step says why). Refused, the install
    # asks again where it needs root.
    if [ "$install" = 1 ] && [ "$EUID" -ne 0 ]; then
        echo "==> Asking for the sudo password once, for the parts installed outside your home folder"
        sudo -v || true
    fi
    # The settings window names the update window rather than opening it, so
    # it appears once the password is in. Its own session, so it outlives this
    # terminal and the checkout move below.
    if [ -n "${AURA_GLASS_UPDATE_WINDOW:-}" ] && [ -n "${AURA_GLASS_PROGRESS_DIR:-}" ]; then
        setsid -f python3 "$AURA_GLASS_UPDATE_WINDOW" --dir "$AURA_GLASS_PROGRESS_DIR" \
            --update </dev/null >/dev/null 2>&1 || true
    fi

    # Before anything can fail, so the window has a pid to watch and a reason
    # to show for whatever stops the update.
    if [ -n "${AURA_GLASS_PROGRESS_DIR:-}" ] && [ -d "$AURA_GLASS_PROGRESS_DIR" ]; then
        PROGRESS_DIR="$AURA_GLASS_PROGRESS_DIR"
        exec > >(tee -a "$PROGRESS_DIR/log") 2>&1
        pevent begin pid "$$" log "$PROGRESS_DIR/log" repo "$repo" dry 0 kind update
        pevent plan id fetch title "Fetching releases"
        pevent plan id switch title "Switching to $target"
        trap 'pexit "$?"' EXIT
        pstart fetch
    fi

    if [ -z "$repo" ] || [ ! -d "$repo/.git" ]; then
        if [ -n "$repo" ] && [ -r "$repo/.packaged" ]; then
            fail "installed from a package — update it with your package manager"
        else
            fail "no git checkout recorded in $conf/repo-path"
        fi
    fi
    local g=(git -C "$repo")

    if ! "${g[@]}" remote get-url origin >/dev/null 2>&1; then
        fail "$repo has no origin remote to update from"
    fi

    # --force so a tag that was moved on the remote replaces the local one rather
    # than stopping the fetch with "would clobber existing tag". --tags brings
    # the branches too (the default refspec still applies). Nothing is pruned:
    # a tag or branch someone made locally is theirs.
    echo "==> Fetching releases and branches from origin"
    "${g[@]}" fetch --force --tags origin

    local kind ref
    if "${g[@]}" rev-parse -q --verify "refs/tags/$target^{commit}" >/dev/null; then
        kind=tag
        ref="refs/tags/$target"
    elif "${g[@]}" rev-parse -q --verify "refs/remotes/origin/$target^{commit}" >/dev/null; then
        kind=branch
        ref="refs/remotes/origin/$target"
    else
        fail "origin has no release or branch called $target"
    fi
    pstart switch

    local stamp
    stamp="$(date +%Y%m%d-%H%M%S)"
    local from
    from="$("${g[@]}" rev-parse --abbrev-ref HEAD 2>/dev/null || echo HEAD)"
    [ "$from" = HEAD ] && from="$("${g[@]}" rev-parse --short=7 HEAD)"

    # Untracked files too: one the target ref also has would stop the checkout
    # with "would be overwritten", which is the same dead end as a dirty tree.
    if [ -n "$("${g[@]}" status --porcelain)" ]; then
        "${g[@]}" stash push --include-untracked \
            -m "aura-glass update $stamp (local edits on $from)" >/dev/null
        echo "==> Your local edits were stashed. Get them back with:"
        echo "      git -C $repo stash list"
        echo "      git -C $repo stash pop"
    fi

    if [ "$kind" = tag ]; then
        echo "==> Switching to release $target"
        "${g[@]}" checkout --quiet --detach "$ref"
    else
        # Commits on the local branch that the remote does not have would be
        # dropped by the reset below, so they get a branch of their own first.
        if "${g[@]}" rev-parse -q --verify "refs/heads/$target" >/dev/null \
            && [ -n "$("${g[@]}" rev-list "$ref..refs/heads/$target" 2>/dev/null)" ]; then
            local backup="aura-glass-backup/$target-$stamp"
            "${g[@]}" branch "$backup" "refs/heads/$target"
            echo "==> Your local commits on $target are kept on the branch $backup"
        fi
        echo "==> Switching to the newest commit on $target"
        "${g[@]}" checkout --quiet -B "$target" --track "origin/$target"
    fi
    echo "    now at $("${g[@]}" log -1 --format='%h %s')"

    if [ "$install" = 0 ]; then
        return 0
    fi

    # The installer's own steps follow in the window; this script has none left.
    pstart ""
    echo "==> Running the installer"
    bash "$repo/install.sh" --gui
    pin_settings_to_dock
    restart_settings_window
    # The installer finished, so whatever the update check found is now what is
    # installed — the window stops offering it.
    rm -f "$conf/update-available"
}

# Put the settings window on the dash, the GNOME dock, after an update. The
# update was started from that window, so it is the app this person reaches for;
# pinning it means the next update (and the changelog it shows) is one click
# away rather than an overview search. Appended, so the user's own order stays,
# and skipped when it is already there. Only when the installer put the entry
# on disk: --no-gui or a missing toolkit leaves nothing to pin.
#
# Once per machine, recorded in dock-pinned: someone who unpins it has answered,
# and the next update putting it back would be overriding them.
pin_settings_to_dock() {
    local id="io.github.DevWebeloper.AuraGlassSettings.desktop" favs
    local marker="${AURA_GLASS_CONF:-$HOME/.config/aura-glass}/dock-pinned"
    [ -e "$marker" ] && return 0
    [ -f "$HOME/.local/share/applications/$id" ] || return 0
    favs="$(gsettings get org.gnome.shell favorite-apps 2>/dev/null)" || return 0
    case "$favs" in
        *"'$id'"*) ;;
        "@as []"|"[]") favs="['$id']" ;;
        *) favs="${favs%]}, '$id']" ;;
    esac
    gsettings set org.gnome.shell favorite-apps "$favs" 2>/dev/null || return 0
    mkdir -p "$(dirname "$marker")" && : > "$marker"
}

# Close the settings window and open it again, now that the installer has put
# the new copy in place. The running one is still the old Python, so without
# this it would go on showing the old Updates page (offering the update just
# installed) until someone thought to close it. Not tied to the update window's
# Log out / Later: install.sh leaves that question to the window and returns, so
# this runs as soon as the install is done, whichever is clicked or neither.
#
# Only when one was open, which it is whenever the update was started from it;
# an update run by hand does not get a window it never had. Opened on the
# Updates page, where it was. A SIGTERM is safe here: the window refuses to
# start an update while a live preview is open, so there is nothing to revert.
restart_settings_window() {
    local app="$HOME/.local/bin/aura-glass-settings" i
    pgrep -u "$(id -u)" -f '^python[0-9.]* .*/aura_glass_settings\.py' >/dev/null 2>&1 || return 0
    pkill -u "$(id -u)" -f '^python[0-9.]* .*/aura_glass_settings\.py' 2>/dev/null || true
    # The relaunch would hand its argv to the old instance while it is still
    # on the bus and exit, so wait for that one to be gone first.
    for i in $(seq 1 25); do
        pgrep -u "$(id -u)" -f '^python[0-9.]* .*/aura_glass_settings\.py' >/dev/null 2>&1 || break
        sleep 0.2
    done
    [ -x "$app" ] || return 0
    setsid -f "$app" --page updates </dev/null >/dev/null 2>&1 || true
}

main "$@"
