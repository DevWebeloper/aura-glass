#!/usr/bin/env bash
# Re-apply the tahoe-glass CSS on top of the installed theme.
#
# All four targets are generated files: re-running the Tahoe theme's own
# install.sh overwrites them and drops these changes. Run this afterwards.
# It is idempotent — an existing block is replaced, never stacked.
set -euo pipefail

DIR="${TAHOE_GLASS_DIR:-$HOME/.config/tahoe-glass}"
THEME="${TAHOE_GLASS_THEME:-Tahoe-Dark}"

SHELL_CSS="$HOME/.themes/$THEME/gnome-shell/gnome-shell.css"
GTK4_CSS="$HOME/.config/gtk-4.0/gtk.css"
GTK4_DARK_CSS="$HOME/.config/gtk-4.0/gtk-dark.css"
GTK3_CSS="$HOME/.config/gtk-3.0/gtk.css"

# The GTK3 half of the theme ships as a gresource and is never written here, so
# user CSS is ours alone — create it if it does not exist. It loads at
# GTK_STYLE_PROVIDER_PRIORITY_USER, above the theme, so it wins on merit.
mkdir -p "$HOME/.config/gtk-3.0"
[ -f "$GTK3_CSS" ] || : > "$GTK3_CSS"

# apply TARGET SNIPPET... — one marked block per target, concatenating every
# snippet that is actually present. Optional sheets are installed and removed
# by install.sh rather than switched on here, so a missing one simply drops out
# and an older $CONF_DIR with only the original sheets keeps working.
apply() {
    local target="$1"; shift
    [ -f "$target" ] || { echo "skip (missing target): $target"; return; }
    local present=() s
    for s in "$@"; do [ -f "$s" ] && present+=("$s"); done
    [ ${#present[@]} -gt 0 ] || { echo "skip (no snippets): $target"; return; }
    python3 - "$target" "${present[@]}" <<'PY'
import sys, re
target, snippets = sys.argv[1], sys.argv[2:]
BEGIN = "/* >>> tahoe-glass BEGIN <<< */"
END   = "/* >>> tahoe-glass END <<< */"

css = open(target, encoding="utf-8").read()
# Drop any block appended previously so re-runs replace instead of stacking.
# "tahoe-tweaks" is the marker this project used before it was named, and is
# stripped too so an in-place upgrade doesn't leave two copies of the CSS.
for name in ("tahoe-glass", "tahoe-tweaks"):
    css = re.sub(
        r"/\* >>> %s BEGIN <<< \*/.*?/\* >>> %s END <<< \*/\n?" % (name, name),
        "", css, flags=re.S,
    )
# Order is the order given: later sheets are overrides and must win on equal
# specificity, so they are concatenated rather than merged.
block = "\n\n".join(
    open(p, encoding="utf-8").read().rstrip("\n") for p in snippets
)
open(target, "w", encoding="utf-8").write(
    css.rstrip("\n") + "\n\n" + BEGIN + "\n" + block + "\n" + END + "\n"
)
print("applied ->", target, "(%d snippet%s)" % (len(snippets), "" if len(snippets) == 1 else "s"))
PY
}

# flat_reset TARGET MODE — emit the blanket "no shadow, no gradient" reset for
# whatever theme is in TARGET right now, on stdout.
#
# This is generated per run rather than committed, because it is derived from
# the theme and the theme is pinned but not frozen. A committed list goes stale
# the moment THEME_REF moves: new decorated selectors appear uncovered, and the
# only symptom is glows quietly coming back. Deriving it here means a theme bump
# regenerates the reset instead of silently degrading the look.
#
# It handles only the blanket cases. Surfaces the theme singles out — the
# Nautilus floating bar, tooltips, the quick-toggle discs — still need the
# hand-written rules in the sheets, which are concatenated after this and so
# win on equal specificity.
flat_reset() {
    python3 - "$1" "$2" <<'PY'
import sys, re

target, mode = sys.argv[1], sys.argv[2]
try:
    css = open(target, encoding="utf-8").read()
except OSError:
    sys.exit(0)

# Only ever read the theme's own CSS, never a block appended on a previous run,
# or the reset would start resetting itself and grow without bound.
for name in ("tahoe-glass", "tahoe-tweaks"):
    css = re.sub(
        r"/\* >>> %s BEGIN <<< \*/.*?/\* >>> %s END <<< \*/\n?" % (name, name),
        "", css, flags=re.S,
    )

def selectors(pattern):
    found, seen = [], set()
    for m in re.finditer(r"([^{}]+)\{([^{}]*)\}", css):
        if not re.search(pattern, m.group(2)):
            continue
        sel = re.sub(r"/\*.*?\*/", " ", m.group(1), flags=re.S)
        sel = sel.replace("*/", " ").replace("/*", " ")
        for part in " ".join(sel.split()).split(","):
            part = part.strip()
            if part and not part.startswith("@") and part not in seen:
                seen.add(part)
                found.append(part)
    return found

if mode == "shell":
    # St has no universal selector, and the sheets' own StWidget reset loses to
    # any theme rule pairing a class with !important — between two !important
    # declarations specificity still decides. Mirroring the theme's own
    # selectors back is the only thing that reliably outranks them.
    sels = selectors(r"(box|text)-shadow\s*:[^;]*!important")
    decls = "  box-shadow: none !important;\n  text-shadow: none !important;"
    why = "theme rules that mark a shadow !important"
else:
    # Flat means one fill value. Every gradient goes, not just the pale ones:
    # the Nautilus sidebar's is dark, and survived a white-only pass.
    sels = selectors(r"gradient")
    decls = "  background-image: none;\n  box-shadow: none;"
    why = "theme rules that paint a gradient"

if not sels:
    sys.exit(0)

print("/* Generated by tahoe-glass-apply from the installed theme — %d %s." % (len(sels), why))
print(" * Not hand-edited and not committed: it is rebuilt on every apply, so a")
print(" * theme update cannot leave it stale. Hand-written rules follow below and")
print(" * override it. */")
print(",\n".join(sels) + " {")
print(decls)
print("}")
PY
}

RESET_DIR="$(mktemp -d)"
trap 'rm -rf "$RESET_DIR"' EXIT

flat_reset "$SHELL_CSS"     shell > "$RESET_DIR/shell-flat.css"
flat_reset "$GTK4_CSS"      gtk4  > "$RESET_DIR/gtk4-flat.css"
flat_reset "$GTK4_DARK_CSS" gtk4  > "$RESET_DIR/gtk4-dark-flat.css"

# The reset goes first so the hand-written sheets, concatenated after it, win.
apply "$SHELL_CSS"     "$RESET_DIR/shell-flat.css" \
                       "$DIR/shell-tweaks.css" "$DIR/shell-popup-blur.css"
apply "$GTK4_CSS"      "$RESET_DIR/gtk4-flat.css" \
                       "$DIR/gtk4-tweaks.css"  "$DIR/gtk4-transparency.css"
apply "$GTK4_DARK_CSS" "$RESET_DIR/gtk4-dark-flat.css" \
                       "$DIR/gtk4-tweaks.css"  "$DIR/gtk4-transparency.css"
# GTK3's half of the theme ships as a gresource, so there is no theme CSS here
# to derive a reset from — gtk3-tweaks.css resets it with `*` instead.
apply "$GTK3_CSS"      "$DIR/gtk3-tweaks.css"

# The User Themes extension reloads on a settings change, not on a file change,
# so toggle the key to force Main.loadTheme().
SD="$HOME/.local/share/gnome-shell/extensions/user-theme@gnome-shell-extensions.gcampax.github.com/schemas"
[ -d "$SD" ] || SD="/usr/share/gnome-shell/extensions/user-theme@gnome-shell-extensions.gcampax.github.com/schemas"
if [ -d "$SD" ]; then
    cur=$(GSETTINGS_SCHEMA_DIR="$SD" gsettings get org.gnome.shell.extensions.user-theme name 2>/dev/null || echo "''")
    cur=${cur#\'}; cur=${cur%\'}
    if [ -n "$cur" ]; then
        GSETTINGS_SCHEMA_DIR="$SD" gsettings set org.gnome.shell.extensions.user-theme name ''
        sleep 1
        GSETTINGS_SCHEMA_DIR="$SD" gsettings set org.gnome.shell.extensions.user-theme name "$cur"
        echo "shell theme reloaded ($cur)"
    fi
fi

# GTK apps read their CSS at startup, so already-running apps keep the old look
# until they are restarted. Nothing to do about that from here.
echo "done — restart GTK apps to pick up the GTK side"
