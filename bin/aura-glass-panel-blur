#!/usr/bin/env bash
# Rebuild Blur My Shell's panel blur whenever the monitor layout changes.
#
# Blur My Shell builds one background actor per monitor and clips it to the
# panel's geometry. Its own source notes that get_transformed_position
# "sometimes yields NaN when the actor is not fully positionned yet" — so an
# actor built before the layout has settled gets clipped in the wrong place and
# part of the top bar shows a strip that does not line up with the wallpaper.
#
# The old fix was `sleep 12` after login and one toggle. That is a guess: it
# waits when nothing is wrong, is still too short on a slow session, and does
# nothing at all when a monitor is plugged in later — which is exactly when a
# per-monitor actor is rebuilt against a layout that is once again in flux.
#
# This waits for the real signal instead. Mutter emits MonitorsChanged on every
# layout change, so each one gets a rebuild, and there is one rebuild at start
# for the login case.
set -euo pipefail

worker="$HOME/.local/share/aura-glass/aura_glass_panel_blur.py"
[ -r "$worker" ] || worker="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/tools/aura_glass_panel_blur.py"
exec python3 "$worker"
