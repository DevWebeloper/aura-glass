#!/usr/bin/env bash
# aura-glass-gdm-sync — dynamically sync desktop wallpaper & primary monitor to GDM login screen
set -euo pipefail

TARGET_WALL="${AURA_GDM_TARGET:-/usr/share/backgrounds/aura-gdm.png}"
[ -n "${AURA_GDM_TARGET:-}" ] || [ -w "$TARGET_WALL" ] || [ ! -w "/usr/share/backgrounds/tahoe-gdm.png" ] || TARGET_WALL="/usr/share/backgrounds/tahoe-gdm.png"
# One picture per monitor layout in monitors.xml, for aura-glass-gdm-layout to
# choose from at boot (it says why). install_gdm makes the directory, owned by
# the desktop user; an older install has none and gets the current layout only.
LAYOUT_DIR="${AURA_GDM_LAYOUTS:-/usr/share/backgrounds/aura-gdm.d}"
USER_MONITORS="$HOME/.config/monitors.xml"
CONF_DIR="${AURA_GLASS_CONF:-$HOME/.config/aura-glass}"

# The login theme lives in a gresource the gnome-shell package owns, so a package
# update puts the stock one back and the login screen loses the theme and this
# wallpaper without a word. install_gdm left the file's checksum in the
# gdm-gresource memo (sha256sum format, path included). A mismatch only warns:
# repairing it needs root and a rebuild for the new shell, which is install_gdm.
check_gresource() {
    local memo="$CONF_DIR/gdm-gresource"
    [ -r "$memo" ] || return 0
    sha256sum -c --status "$memo" >/dev/null 2>&1 && return 0

    local line gr repo cmd
    line="$(head -n1 "$memo")"
    gr="${line#*  }"
    repo="$(cat "$CONF_DIR/repo-path" 2>/dev/null || true)"
    cmd="./install.sh --gdm"
    [ -n "$repo" ] && cmd="$repo/install.sh --gdm"
    echo "aura-glass-gdm-sync: $gr is no longer the Aura Glass login theme (a package update replaced it); run $cmd" >&2
    if command -v notify-send >/dev/null 2>&1; then
        notify-send \
            --app-name="Aura Glass" \
            --icon=preferences-desktop-appearance \
            --hint=string:x-canonical-private-synchronous:aura-glass-gdm \
            "Login screen theme was reset" \
            "A system update replaced the GDM theme, so the login screen is back to stock. Run $cmd to reinstall it." \
            || true
    fi
}

# install_gdm copies the desktop's cursor and icons for the login screen, which
# takes root, so a later change of pack or accent stops there. It only warns, the
# same way. Light and dark of one pack count as the same: icon-sync swaps between
# them with the colour scheme, and the choice install_gdm made still stands.
# Twin of gdm_cursor_copy_complete in lib/steps-gdm.sh (why it exists is there):
# this fast path runs at every login without sourcing lib/.
cursor_copy_complete() {
    local src="$HOME/.local/share/icons/$1/cursors" dest="/usr/share/icons/$1" f
    [ -d "$src" ] || return 0
    [ -d "$dest" ] && [ ! -e "$dest/.aura-glass-gdm" ] && return 0
    for f in "$src"/*; do
        [ -e "$dest/cursors/${f##*/}" ] || return 1
    done
}

check_look() {
    local memo="$CONF_DIR/gdm-look" icon cursor size want_icon want_cursor want_size repo
    [ -r "$memo" ] || return 0
    { read -r want_icon; read -r want_cursor; read -r want_size; } < "$memo" || true
    icon="$(gsettings get org.gnome.desktop.interface icon-theme 2>/dev/null | tr -d "'")"
    cursor="$(gsettings get org.gnome.desktop.interface cursor-theme 2>/dev/null | tr -d "'")"
    size="$(gsettings get org.gnome.desktop.interface cursor-size 2>/dev/null || true)"
    size="${size##* }"
    [ -n "$icon" ] && [ -n "$cursor" ] || return 0
    icon="${icon%-dark}"; want_icon="${want_icon%-dark}"
    [ "$icon" = "$want_icon" ] && [ "$cursor" = "$want_cursor" ] && [ "$size" = "$want_size" ] \
        && cursor_copy_complete "$cursor" && return 0

    repo="$(cat "$CONF_DIR/repo-path" 2>/dev/null || true)"
    if [ -n "$repo" ] && [ -f "$repo/lib/steps-gdm.sh" ]; then
        if env HOME="$HOME" CONF_DIR="$CONF_DIR" REPO_ROOT="$repo" bash -c 'set -euo pipefail; REPO_ROOT="$1"; conf="${CONF_DIR:-}"; . "$REPO_ROOT/lib/common.sh"; . "$REPO_ROOT/lib/steps.sh"; . "$REPO_ROOT/lib/steps-fonts.sh"; . "$REPO_ROOT/lib/steps-gdm.sh"; [ -n "$conf" ] && CONF_DIR="$conf"; sync_gdm_look && gdm_look_matches_memo' _ "$repo"; then
            return 0
        fi
    fi
    echo "aura-glass-gdm-sync: could not update the login screen's cursor and icons. Press Apply in the Aura Glass settings to try again." >&2
    if command -v notify-send >/dev/null 2>&1; then
        notify-send \
            --app-name="Aura Glass" \
            --icon=preferences-desktop-appearance \
            --hint=string:x-canonical-private-synchronous:aura-glass-gdm-look \
            "Login screen cursor and icons differ" \
            "Aura Glass could not update the login screen's cursor and icons. Press Apply in the Aura Glass settings to try again." \
            || true
    fi
}

get_wallpaper() {
    local uri
    uri="$(gsettings get org.gnome.desktop.background picture-uri-dark 2>/dev/null || true)"
    uri="${uri//\'/}"
    if [ -z "$uri" ] || [ "$uri" = "nothing" ] || [ "$uri" = "''" ]; then
        uri="$(gsettings get org.gnome.desktop.background picture-uri 2>/dev/null || true)"
        uri="${uri//\'/}"
    fi
    if [[ "$uri" =~ ^file://(.*) ]]; then
        python3 -c "import urllib.parse, sys; print(urllib.parse.unquote(sys.argv[1][7:]))" "$uri" 2>/dev/null || echo "${uri#file://}"
    else
        echo "$uri"
    fi
}

sync_wallpaper() {
    [ -w "$TARGET_WALL" ] || return 0
    local wall; wall="$(get_wallpaper)"
    [ -n "$wall" ] && [ -f "$wall" ] || return 0

    # Three watchers below can each call this, and subshells share $$, so a
    # fixed /tmp/aura-gdm-sync-$$.png let two renders write one file.
    local tmp
    tmp="$(mktemp --suffix=.png /tmp/aura-gdm-sync-XXXXXX)" || return 0
    local layouts=""
    [ -d "$LAYOUT_DIR" ] && [ -w "$LAYOUT_DIR" ] && [ ! -L "$LAYOUT_DIR" ] && layouts="$LAYOUT_DIR"
    python3 - "$wall" "$tmp" "$layouts" "$USER_MONITORS" <<'PY' || { rm -f "$tmp"; return 0; }
import os, sys, urllib.parse, subprocess, tempfile
from PIL import Image, ImageFilter, ImageEnhance, ImageOps

src = sys.argv[1]
dst = sys.argv[2]
layout_dir = sys.argv[3]
monitors_xml = sys.argv[4]

if not os.path.exists(src):
    sys.exit(1)


def render():
    if src.lower().endswith(('.svg', '.svgz')):
        try:
            subprocess.run([
                "magick", "-density", "150", src,
                "-resize", "2560x1440^", "-gravity", "center", "-extent", "2560x1440",
                "-blur", "0x30", "-fill", "black", "-colorize", "40%", dst
            ], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return True
        except Exception:
            pass

    try:
        im = Image.open(src).convert('RGB')
        im.thumbnail((2560, 1440), Image.Resampling.LANCZOS)
        im = im.filter(ImageFilter.GaussianBlur(radius=30))
        enhancer = ImageEnhance.Brightness(im)
        im = enhancer.enhance(0.55)
        im.save(dst, format="PNG")
        return True
    except Exception:
        try:
            subprocess.run([
                "magick", src,
                "-resize", "2560x1440^", "-gravity", "center", "-extent", "2560x1440",
                "-blur", "0x30", "-fill", "black", "-colorize", "40%", dst
            ], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return True
        except Exception:
            return False


def monitor_rects():
    """Logical rects of this session's monitors: the layout sync_monitors copies to GDM."""
    try:
        import gi
        gi.require_version('Gio', '2.0')
        from gi.repository import Gio
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        state = bus.call_sync(
            'org.gnome.Mutter.DisplayConfig', '/org/gnome/Mutter/DisplayConfig',
            'org.gnome.Mutter.DisplayConfig', 'GetCurrentState',
            None, None, Gio.DBusCallFlags.NONE, 2000, None).unpack()
    except Exception:
        return []
    serial, monitors, logical, props = state
    modes = {}
    for spec, mode_list, _ in monitors:
        for mode in mode_list:
            if mode[6].get('is-current'):
                modes[spec[0]] = (mode[1], mode[2])
    physical = props.get('layout-mode') == 2
    rects = []
    for x, y, scale, transform, _, specs, _ in logical:
        if not specs or specs[0][0] not in modes:
            continue
        w, h = modes[specs[0][0]]
        if transform % 2:
            w, h = h, w
        if not physical:
            w, h = round(w / scale), round(h / scale)
        rects.append((x, y, w, h))
    return rects


# The greeter has no per-monitor backgrounds (layout.js returns early from
# _updateBackgrounds when sessionMode.isGreeter), so this image is only ever
# drawn as the `#lockDialogGroup` CSS background, and that actor spans the whole
# stage. With one image, background-size: cover stretched it across every
# monitor at once. Instead lay it out like the stage: one zoomed copy per
# monitor rect, the canvas the size of the stage's bounding box, so cover maps
# it back 1:1. Gaps between unequal monitors are never on screen; they take the
# theme's #lockDialogGroup background-color.
def lay_out(im, rects):
    """im laid out like a stage of rects; im itself for one monitor."""
    if len(rects) < 2:
        return im
    x0 = min(r[0] for r in rects)
    y0 = min(r[1] for r in rects)
    width = max(r[0] + r[2] for r in rects) - x0
    height = max(r[1] + r[3] for r in rects) - y0
    # The image is blurred, so 3840 px across keeps the file small with no
    # visible loss on a wide two-monitor stage.
    k = min(1.0, 3840 / width)
    canvas = Image.new('RGB', (max(1, round(width * k)), max(1, round(height * k))), (0x22, 0x22, 0x26))
    for x, y, w, h in rects:
        tile = ImageOps.fit(im, (max(1, round(w * k)), max(1, round(h * k))), Image.Resampling.LANCZOS)
        canvas.paste(tile, (round((x - x0) * k), round((y - y0) * k)))
    return canvas


def saved_layouts():
    """(key, rects) for each configuration in the user's monitors.xml.

    The key is every connector the configuration names, enabled or disabled,
    sorted and joined with '+': the outputs that must be plugged in for Mutter
    to choose it, which is all aura-glass-gdm-layout can see at boot."""
    import xml.etree.ElementTree as ET
    out = []
    for conf in ET.parse(monitors_xml).getroot().findall('configuration'):
        physical = (conf.findtext('layoutmode') or 'logical').strip() == 'physical'
        connectors, rects = set(), []
        for lm in conf.findall('logicalmonitor'):
            mons = lm.findall('monitor')
            for m in mons:
                connectors.add(m.findtext('monitorspec/connector', '').strip())
            if not mons:
                continue
            w = int(mons[0].findtext('mode/width'))
            h = int(mons[0].findtext('mode/height'))
            if (lm.findtext('transform/rotation') or '').strip() in ('left', 'right'):
                w, h = h, w
            scale = float(lm.findtext('scale') or 1)
            if not physical:
                w, h = round(w / scale), round(h / scale)
            rects.append((int(lm.findtext('x')), int(lm.findtext('y')), w, h))
        for spec in conf.findall('disabled/monitorspec'):
            connectors.add(spec.findtext('connector', '').strip())
        connectors.discard('')
        if connectors and rects:
            out.append(('+'.join(sorted(connectors)), rects))
    return out


def save_atomic(im, path):
    fd, tmp = tempfile.mkstemp(suffix='.png', dir=os.path.dirname(path))
    try:
        with os.fdopen(fd, 'wb') as f:
            im.save(f, format='PNG')
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except Exception:
        os.unlink(tmp)
        raise


# The login screen is drawn before any session, on whatever monitors are
# plugged in at boot, so the current layout's picture is wrong after a change
# made while powered off: unplug the external monitor, boot, and GDM cover-scales
# a two-monitor canvas onto the laptop panel alone. Every saved layout gets its
# own picture here, plus single.png for one output, and aura-glass-gdm-layout
# copies the one for the connected outputs over the login wallpaper at boot.
def write_layouts(base):
    if not layout_dir:
        return
    keep = {'single.png'}
    save_atomic(base, os.path.join(layout_dir, 'single.png'))
    try:
        layouts = saved_layouts() if os.path.isfile(monitors_xml) else []
    except Exception:
        layouts = []
    for key, rects in layouts:
        name = key + '.png'
        if '/' in name or name in keep:
            continue
        keep.add(name)
        save_atomic(lay_out(base, rects), os.path.join(layout_dir, name))
    for name in os.listdir(layout_dir):
        if name.endswith('.png') and name not in keep:
            try:
                os.unlink(os.path.join(layout_dir, name))
            except OSError:
                pass


if not render():
    sys.exit(1)
base = Image.open(dst).convert('RGB')
try:
    write_layouts(base)
except Exception:
    pass
try:
    lay_out(base, monitor_rects()).save(dst, format="PNG")
except Exception:
    pass
sys.exit(0)
PY

    if [ -f "$tmp" ]; then
        mv -f "$tmp" "$TARGET_WALL" 2>/dev/null || cp -f "$tmp" "$TARGET_WALL" 2>/dev/null || true
        rm -f "$tmp"
    fi
}

sync_monitors() {
    [ -f "$USER_MONITORS" ] || return 0
    local targets=(
        "/etc/xdg/monitors.xml"
        "/var/lib/gdm/.config/monitors.xml"
        "/var/lib/gdm3/.config/monitors.xml"
        "/var/lib/gdm/seat0/config/monitors.xml"
        "/var/lib/gdm/seat0/.config/monitors.xml"
        "/var/lib/gdm3/seat0/config/monitors.xml"
        "/var/lib/gdm3/seat0/.config/monitors.xml"
    )
    for target in "${targets[@]}"; do
        local dir; dir="$(dirname "$target")"
        if [ -w "$target" ] || [ -w "$dir" ]; then
            if ! cmp -s "$USER_MONITORS" "$target" 2>/dev/null; then
                cp -f "$USER_MONITORS" "$target" 2>/dev/null || true
            fi
        fi
    done
}

# One-shot sync mode
if [ "${1:-}" = "--once" ] || [ "${1:-}" = "-1" ]; then
    check_gresource || true
    check_look || true
    sync_wallpaper || true
    sync_monitors || true
    exit 0
fi

# Initial sync on session start
check_gresource || true
check_look || true
sync_wallpaper || true
sync_monitors || true

trap 'kill $(jobs -p) 2>/dev/null || true' EXIT INT TERM

# Monitor background changes and display changes in parallel
(
    gsettings monitor org.gnome.desktop.background 2>/dev/null | while read -r _; do
        while read -t 1 -r _; do :; done
        sync_wallpaper || true
    done
) &

(
    gdbus monitor --session --dest org.gnome.Mutter.DisplayConfig \
                  --object-path /org/gnome/Mutter/DisplayConfig 2>/dev/null \
        | while read -r line; do
            case "$line" in
                *MonitorsChanged*)
                    while read -t 2 -r _; do :; done
                    sync_monitors || true
                    # The GDM wallpaper is laid out per monitor, so a new layout needs a new image.
                    sync_wallpaper || true
                    ;;
            esac
        done
) &

# Mutter emits MonitorsChanged as soon as a new layout is applied, but writes
# monitors.xml only when it is kept: meta_monitor_manager_confirm_configuration
# saves it on "Keep Changes", up to 20 s later. So the sync above copies the
# layout being replaced, and a scale change left GDM on the old scale under a
# wallpaper laid out for the new one, misplaced on the login screen. Sync again
# when the file is written (an atomic rename, which gio monitor reports).
(
    gio monitor "$USER_MONITORS" 2>/dev/null | while read -r _; do
        while read -t 1 -r _; do :; done
        sync_monitors || true
        sync_wallpaper || true
    done
) &

wait || true
