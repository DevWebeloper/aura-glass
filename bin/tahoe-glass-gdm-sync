#!/usr/bin/env bash
# tahoe-glass-gdm-sync — dynamically sync desktop wallpaper & primary monitor to GDM login screen
set -euo pipefail

TARGET_WALL="/usr/share/backgrounds/tahoe-gdm.png"
USER_MONITORS="$HOME/.config/monitors.xml"

get_wallpaper() {
    local uri
    uri="$(gsettings get org.gnome.desktop.background picture-uri-dark 2>/dev/null || true)"
    uri="${uri//\'/}"
    if [ -z "$uri" ] || [ "$uri" = "nothing" ] || [ "$uri" = "''" ]; then
        uri="$(gsettings get org.gnome.desktop.background picture-uri 2>/dev/null || true)"
        uri="${uri//\'/}"
    fi
    if [[ "$uri" =~ ^file://(.*) ]]; then
        python3 -c "import urllib.parse, sys; print(urllib.parse.unquote(sys.argv[1][7:]))" "$uri" 2>/dev/null || echo "${uri#file://}"
    else
        echo "$uri"
    fi
}

sync_wallpaper() {
    [ -w "$TARGET_WALL" ] || return 0
    local wall; wall="$(get_wallpaper)"
    [ -n "$wall" ] && [ -f "$wall" ] || return 0

    local tmp="/tmp/tahoe-gdm-sync-$$.png"
    python3 - "$wall" "$tmp" <<'PY' || return 0
import os, sys, urllib.parse, subprocess
from PIL import Image, ImageFilter, ImageEnhance

src = sys.argv[1]
dst = sys.argv[2]

if not os.path.exists(src):
    sys.exit(1)

if src.lower().endswith(('.svg', '.svgz')):
    try:
        subprocess.run([
            "magick", "-density", "150", src,
            "-resize", "2560x1440^", "-gravity", "center", "-extent", "2560x1440",
            "-blur", "0x30", "-fill", "black", "-colorize", "40%", dst
        ], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        sys.exit(0)
    except Exception:
        pass

try:
    im = Image.open(src).convert('RGB')
    im.thumbnail((2560, 1440), Image.Resampling.LANCZOS)
    im = im.filter(ImageFilter.GaussianBlur(radius=30))
    enhancer = ImageEnhance.Brightness(im)
    im = enhancer.enhance(0.55)
    im.save(dst, format="PNG")
    sys.exit(0)
except Exception:
    try:
        subprocess.run([
            "magick", src,
            "-resize", "2560x1440^", "-gravity", "center", "-extent", "2560x1440",
            "-blur", "0x30", "-fill", "black", "-colorize", "40%", dst
        ], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        sys.exit(0)
    except Exception:
        sys.exit(1)
PY

    if [ -f "$tmp" ]; then
        mv -f "$tmp" "$TARGET_WALL" 2>/dev/null || cp -f "$tmp" "$TARGET_WALL" 2>/dev/null || true
        rm -f "$tmp"
    fi
}

sync_monitors() {
    [ -f "$USER_MONITORS" ] || return 0
    local targets=(
        "/etc/xdg/monitors.xml"
        "/var/lib/gdm/.config/monitors.xml"
        "/var/lib/gdm3/.config/monitors.xml"
        "/var/lib/gdm/seat0/config/monitors.xml"
        "/var/lib/gdm/seat0/.config/monitors.xml"
        "/var/lib/gdm3/seat0/config/monitors.xml"
        "/var/lib/gdm3/seat0/.config/monitors.xml"
    )
    for target in "${targets[@]}"; do
        local dir; dir="$(dirname "$target")"
        if [ -w "$target" ] || [ -w "$dir" ]; then
            if ! cmp -s "$USER_MONITORS" "$target" 2>/dev/null; then
                cp -f "$USER_MONITORS" "$target" 2>/dev/null || true
            fi
        fi
    done
}

# Initial sync on session start
sync_wallpaper || true
sync_monitors || true

# Monitor background changes and display changes in parallel
(
    gsettings monitor org.gnome.desktop.background 2>/dev/null | while read -r _; do
        sleep 1
        sync_wallpaper || true
    done
) &

(
    gdbus monitor --session --dest org.gnome.Mutter.DisplayConfig \
                  --object-path /org/gnome/Mutter/DisplayConfig 2>/dev/null \
        | while read -r line; do
            case "$line" in
                *MonitorsChanged*)
                    sleep 2
                    sync_monitors || true
                    ;;
            esac
        done
) &

wait
