#!/usr/bin/env bash
# Keep the icon theme in step with the system light/dark preference.
#
# GNOME has one icon-theme key and no notion of a light and a dark variant of
# the same set, so switching Settings > Appearance between Light and Dark
# leaves the icons wherever they were. Colloid ships -Light and -Dark builds of
# every accent, which is exactly the pair that key cannot express.
#
# This watches org.gnome.desktop.interface color-scheme and writes the matching
# variant. With no argument it runs as a daemon; `--once` just corrects the
# current setting and exits.
set -euo pipefail

# The pack answer, not the resolved theme name: "keep" means --no-icons, and
# nothing of this theme's writes icon-theme under it. Checked at every apply
# rather than only at startup, so an agent already running when the answer
# changes stops writing the key from that moment rather than at the next login.
icons_kept() {
    local pack=""
    if [ -r "$HOME/.config/aura-glass/icon-pack" ]; then
        pack="$(cat "$HOME/.config/aura-glass/icon-pack")"
    fi
    [ "$pack" = keep ]
}

BASE="${AURA_GLASS_ICONS:-${TAHOE_GLASS_ICONS:-}}"
if [ -z "$BASE" ]; then
    if [ -r "$HOME/.config/aura-glass/icons" ]; then
        BASE="$(cat "$HOME/.config/aura-glass/icons")"
    elif [ -r "$HOME/.config/tahoe-glass/icons" ]; then
        BASE="$(cat "$HOME/.config/tahoe-glass/icons")"
    fi
fi
BASE="${BASE:-Colloid}"

have_theme() {
    [ -d "$HOME/.local/share/icons/$1" ] || [ -d "/usr/share/icons/$1" ]
}

apply() {
    local scheme variant want c
    icons_kept && return 0
    scheme="$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null || echo "''")"
    case "$scheme" in
        *prefer-dark*) variant="Dark" ;;
        *)             variant="Light" ;;
    esac

    # Packs disagree about how they spell the pair. Colloid ships -Light and
    # -Dark; Reversal ships the bare name for light and -dark for dark. Try
    # both spellings, then the bare name — a set with only one half is left on
    # that half rather than swapped for something that would look wrong.
    want=""
    for c in "$BASE-$variant" \
             "$BASE-$(printf '%s' "$variant" | tr '[:upper:]' '[:lower:]')" \
             "$BASE"; do
        if have_theme "$c"; then want="$c"; break; fi
    done
    [ -n "$want" ] || return 0

    local cur
    cur="$(gsettings get org.gnome.desktop.interface icon-theme 2>/dev/null | tr -d \")"
    cur="${cur#\'}"; cur="${cur%\'}"
    [ "$cur" = "$want" ] && return 0
    gsettings set org.gnome.desktop.interface icon-theme "$want"
}

apply
[ "${1:-}" = "--once" ] && exit 0

# gsettings monitor prints a line per change and never exits, so this is the
# whole loop. Any line is a colour-scheme change worth reacting to.
gsettings monitor org.gnome.desktop.interface color-scheme | while read -r _; do
    apply || true
done
