post_install() {
    echo ":: Aura Glass is now installed on your system."
    echo ":: To setup and apply Aura Glass for your user session, run:"
    echo "     aura-glass"
    echo ":: Or launch 'Aura Glass Settings' from your application menu."
}

post_upgrade() {
    echo ":: Aura Glass has been upgraded."
    echo ":: To re-apply updated styles and presets to your running session, run:"
    echo "     aura-glass-apply"
    echo ":: Or re-tune your settings with:"
    echo "     aura-glass --settings-only -y"
}

# The uninstaller lives in /usr/share/aura-glass, which is gone by
# post_remove, so the advice has to come before removal.
pre_remove() {
    echo ":: Removing Aura Glass package files from /usr."
    echo ":: To revert user themes and dconf settings, each user should first run:"
    echo "     /usr/share/aura-glass/uninstall.sh"
    echo ":: (or uninstall.sh from a git checkout, after this package is gone)"
}
